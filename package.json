{
  "name": "extrovert",
  "version": "1.0.4",
  "description": "A social network where you only discover content from friends and friends of friends.",
  "license": "GPL-3.0-or-later",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/test.js",
    "test:api": "node --test scripts/api-test.js",
    "test:owasp": "node --test scripts/owasp-test.js",
    "test:asvs": "node --test scripts/asvs-test.js",
    "test:render": "node scripts/render-smoke.js",
    "test:oauth": "node scripts/oauth-flow-test.js",
    "test:multi-account": "node scripts/multi-account-test.js",
    "test:twofa": "node scripts/twofa-test.js",
    "test:passkeys": "node scripts/passkeys-test.js",
    "test:passkey-add": "node scripts/passkey-add-account-test.js",
    "test:captcha": "node scripts/captcha-test.js",
    "test:email": "node scripts/email-e2e-test.js && node scripts/admin-mail-smoke.js && node scripts/mailer-tls-test.js",
    "test:client": "node --test scripts/client-parity-test.js",
    "test:bootstrap": "node --test scripts/client-bootstrap-test.js",
    "seed:client": "node scripts/seed-client-test.js",
    "build:mls": "esbuild src/client-mls/entry.js --bundle --minify --sourcemap --format=iife --global-name=MLSModule --outfile=public/lib/mls.js",
    "test:mls": "node scripts/mls-conformance-test.js && node scripts/mls-db-test.js && node scripts/mls-api-test.js && node scripts/mls-e2e-chat-test.js && node scripts/mls-welcome-recovery-test.js",
    "test:ietf": "node scripts/mls-ietf-vectors-test.js",
    "test:interop": "node scripts/mls-rs-interop-test.js",
    "test:scale": "node scripts/mls-scale-benchmark.js"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "helmet": "^8.2.0",
    "markdown-it": "^15.0.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.35.3",
    "svg-captcha": "^1.4.0",
    "swagger-ui-dist": "5.17.14",
    "ts-mls": "^1.6.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
