<%- include('partials/header') %>
  <div class="card">
    <h2 style="margin-top:0">Edit your profile</h2>

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:22px">
      <% if (profileUser.avatar) { %>
        <img src="<%= profileUser.avatar %>" alt="" class="avatar-preview">
      <% } else { %>
        <div class="avatar-preview"><%= (profileUser.display_name || '?').slice(0,1).toUpperCase() %></div>
      <% } %>
      <div>
        <form method="post" action="/u/<%= profileUser.username %>/avatar" enctype="multipart/form-data" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="file" name="avatar" accept="image/*" required style="display:none" id="avatarInput">
          <button class="btn ghost" type="button" id="avatarUploadBtn"><%- include('partials/icon', { name: 'image', size: 15 }) %> Upload photo</button>
          <small class="muted" style="display:block;margin-top:6px">Square JPEG/PNG, max 5 MB</small>
        </form>
        <% if (profileUser.avatar) { %>
          <form method="post" action="/u/<%= profileUser.username %>/avatar/remove" style="margin:6px 0 0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn ghost danger small"><%- include('partials/icon', { name: 'trash', size: 13 }) %> Remove</button>
          </form>
        <% } %>
      </div>
    </div>

    <form method="post" action="/u/<%= profileUser.username %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="edit-displayName">Display name</label>
      <input type="text" name="displayName" id="edit-displayName" value="<%= displayName %>" maxlength="60">

      <label for="edit-bio">Bio</label>
      <textarea name="bio" id="edit-bio" rows="2" maxlength="280"><%= bio %></textarea>

      <label for="edit-effect">Profile effect <span class="muted">(plays once when someone opens your profile — up to 2 seconds)</span></label>
      <select name="effect" id="edit-effect">
        <option value="" <%= !effect ? 'selected' : '' %>>None</option>
        <option value="matrix" <%= effect === 'matrix' ? 'selected' : '' %>>Matrix</option>
        <option value="glitch" <%= effect === 'glitch' ? 'selected' : '' %>>Glitch</option>
      </select>

      <label for="edit-html">Profile HTML <span class="muted">(no &lt;script&gt;, no JS — stripped automatically)</span></label>
      <textarea name="html" id="edit-html" rows="10" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:13px"><%= html %></textarea>
      <small class="muted">Put <code>&lt;!--POSTS--&gt;</code> where you want your posts to appear. If omitted, posts are shown at the end.</small>

      <label for="edit-css">Profile CSS <span class="muted">(styles the whole page)</span></label>
      <textarea name="css" id="edit-css" rows="10" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:13px"><%= css %></textarea>

      <div style="margin-top:18px;display:flex;gap:10px">
        <button class="btn"><%- include('partials/icon', { name: 'check', size: 15 }) %> Save</button>
        <a class="btn ghost" href="/u/<%= profileUser.username %>">Cancel</a>
      </div>
    </form>
  </div>
  <script src="/static/avatar.js?v=1"></script>
<%- include('partials/footer') %>