<%- include('partials/header') %>
  <div class="card">
    <h2 style="margin-top:0">Edit your profile</h2>
    <p class="muted" style="margin:0 0 18px">Prefer clicking over typing? <a href="/u/<%= profileUser.username %>?edit=1">Open Easy Editing</a> — the visual editor and these fields are the same document.</p>

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:22px">
      <% if (profileUser.avatar) { %>
        <img src="<%= profileUser.avatar %>" alt="" class="avatar-preview">
      <% } else { %>
        <div class="avatar-preview"><%= (profileUser.display_name || '?').slice(0,1).toUpperCase() %></div>
      <% } %>
      <div>
        <form method="post" action="/u/<%= profileUser.username %>/avatar" enctype="multipart/form-data" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="file" name="avatar" accept="image/*" required style="display:none" id="avatarInput">
          <button class="btn ghost" type="button" id="avatarUploadBtn"><%- include('partials/icon', { name: 'image', size: 15 }) %> Upload photo</button>
          <small class="muted" style="display:block;margin-top:6px">Square JPEG/PNG, max 5 MB</small>
        </form>
        <% if (profileUser.avatar) { %>
          <form method="post" action="/u/<%= profileUser.username %>/avatar/remove" style="margin:6px 0 0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn ghost danger small"><%- include('partials/icon', { name: 'trash', size: 13 }) %> Remove</button>
          </form>
        <% } %>
      </div>
    </div>

    <h4 style="margin:22px 0 8px">Custom font</h4>
    <p class="muted" style="font-size:0.8rem;margin:0 0 10px">woff2, woff, ttf or otf — stored in your Drive and served at <code>/u/<%= profileUser.username %>/font</code>.</p>
    <% if (customFont) { %>
      <div class="font-row">
        <span class="font-current"><%- include('partials/icon', { name: 'doc', size: 14 }) %> <%= customFont.name %></span>
        <form method="post" action="/u/<%= profileUser.username %>/font/remove" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn ghost danger small"><%- include('partials/icon', { name: 'trash', size: 13 }) %> Remove</button>
        </form>
      </div>
      <label for="font-snippet">Paste this into your profile CSS to use it</label>
      <textarea id="font-snippet" rows="5" readonly onclick="this.select()" style="font-family:ui-monospace,monospace;font-size:12px">@font-face {
  font-family: '<%= customFont.family %>';
  src: url('/u/<%= profileUser.username %>/font?v=<%= customFont.id %>');
}
body { font-family: '<%= customFont.family %>', sans-serif; }</textarea>
    <% } %>
    <form method="post" action="/u/<%= profileUser.username %>/font" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="font" accept=".woff2,.woff,.ttf,.otf" required>
      <button class="btn ghost small" style="margin-top:8px"><%- include('partials/icon', { name: 'image', size: 13 }) %> <%= customFont ? 'Replace font' : 'Upload font' %></button>
    </form>

    <form method="post" action="/u/<%= profileUser.username %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="edit-displayName">Display name</label>
      <input type="text" name="displayName" id="edit-displayName" value="<%= displayName %>" maxlength="60">

      <label for="edit-bio">Bio</label>
      <textarea name="bio" id="edit-bio" rows="2" maxlength="280"><%= bio %></textarea>

      <label>Pronouns <span class="muted">(2 fields by default, up to <%= pronounFieldsMax %> — free text, e.g. he/him)</span></label>
      <div class="pronoun-rows" id="pronounRows" data-max="<%= pronounFieldsMax %>">
        <% var pronounFields = pronouns.slice(); while (pronounFields.length < 2) pronounFields.push(''); %>
        <% pronounFields.forEach(function(p, i) { %>
          <div class="pronoun-row">
            <input type="text" name="pronoun" maxlength="<%= pronounLengthMax %>" value="<%= p %>" placeholder="<%= i === 0 ? 'he/him' : 'they/them' %>" aria-label="Pronouns field <%= i + 1 %>">
            <button type="button" class="btn ghost small pronoun-remove" aria-label="Remove this field"<%= i < 2 ? ' hidden' : '' %>>&times;</button>
          </div>
        <% }); %>
      </div>
      <button type="button" class="btn ghost small" id="pronounAdd"><%- include('partials/icon', { name: 'plus', size: 13 }) %> Add field</button>

      <label for="edit-effect">Profile effect <span class="muted">(plays once when someone opens your profile — up to 2 seconds)</span></label>
      <select name="effect" id="edit-effect">
        <option value="" <%= !effect ? 'selected' : '' %>>None</option>
        <option value="matrix" <%= effect === 'matrix' ? 'selected' : '' %>>Matrix</option>
        <option value="glitch" <%= effect === 'glitch' ? 'selected' : '' %>>Glitch</option>
      </select>

      <label for="edit-html">Profile HTML <span class="muted">(no &lt;script&gt;, no JS — stripped automatically)</span></label>
      <textarea name="html" id="edit-html" rows="14" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:13px"><%= html %></textarea>
      <small class="muted">This is the whole page. Live content is placed with slot elements, e.g. <code>&lt;div data-ev-slot="posts"&gt;&lt;/div&gt;</code>. Slots: <code>avatar, displayName, botBadge, handle, pronouns, bio, stats, follow, chat, report, posts</code>. Keep them empty; the server fills them.</small>

      <label for="edit-css">Profile CSS <span class="muted">(styles the whole page)</span></label>
      <textarea name="css" id="edit-css" rows="10" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:13px"><%= css %></textarea>

      <div style="margin-top:18px;display:flex;gap:10px">
        <button class="btn"><%- include('partials/icon', { name: 'check', size: 15 }) %> Save</button>
        <a class="btn ghost" href="/u/<%= profileUser.username %>">Cancel</a>
      </div>
    </form>
  </div>
  <script src="/static/avatar.js?v=1"></script>
  <script src="/static/pronouns.js?v=1"></script>
<%- include('partials/footer') %>