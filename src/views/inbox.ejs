<%- include('partials/header') %>
  <div class="card" style="display:flex;justify-content:space-between;align-items:center">
    <h2 style="margin:0">Notifications</h2>
    <% if (notifications.length) { %><small class="muted"><%= notifications.filter(n=>!n.read).length %> new</small><% } %>
  </div>

  <% if (notifications.length === 0) { %>
    <div class="card empty-state">
      <div class="empty-art"><%- include('partials/rings', { size: 56, animate: true }) %></div>
      <h4>All quiet</h4>
      <p>When people interact with you, it'll show up here.</p>
    </div>
  <% } else { %>
    <% notifications.forEach(function(n){ %>
      <div class="card notif <%= n.read ? '' : 'unread' %>">
        <div class="notif-icon">
          <% if (n.type === 'follow') { %><%- include('partials/icon', { name: 'user', size: 18 }) %><% } %>
          <% if (n.type === 'like') { %><%- include('partials/icon', { name: 'heartFilled', size: 18 }) %><% } %>
          <% if (n.type === 'comment') { %><%- include('partials/icon', { name: 'comment', size: 18 }) %><% } %>
          <% if (n.type === 'share') { %><%- include('partials/icon', { name: 'share', size: 18 }) %><% } %>
          <% if (n.type === 'repost') { %><%- include('partials/icon', { name: 'repost', size: 18 }) %><% } %>
          <% if (n.type === 'message') { %><%- include('partials/icon', { name: 'chat', size: 18 }) %><% } %>
          <% if (n.type === 'mention') { %><%- include('partials/icon', { name: 'at', size: 18 }) %><% } %>
          <% if (n.type === 'missed_call') { %><%- include('partials/icon', { name: 'phone', size: 18 }) %><% } %>
          <% if (n.type === 'security') { %><%- include('partials/icon', { name: 'shield', size: 18 }) %><% } %>
        </div>
        <div class="notif-body">
          <% if (n.type === 'security') { %>
            <b>Security notice:</b> New login to your account from a new client or device.
          <% } else { %>
            <a href="/u/<%= encodeURIComponent(n.actor_username) %>"><b><%= n.actor_name %></b></a>
            <% if (n.type === 'follow') { %>followed you<% } %>
            <% if (n.type === 'like') { %>liked your <a href="/posts/<%= n.post_id %>">post</a><% } %>
            <% if (n.type === 'comment') { %>commented on your <a href="/posts/<%= n.post_id %>">post</a><% } %>
            <% if (n.type === 'share') { %>shared your <a href="/posts/<%= n.post_id %>">post</a><% } %>
            <% if (n.type === 'repost') { %>reposted your <a href="/posts/<%= n.post_id %>">post</a><% } %>
            <% if (n.type === 'message') { %>sent you a <a href="/chats/<%= n.actor_username %>">message</a><% } %>
            <% if (n.type === 'mention') { %>mentioned you in a <a href="/posts/<%= n.post_id %>">post</a><% } %>
            <% if (n.type === 'missed_call') { %>called you — <a href="/chats/<%= n.actor_username %>?call=1">call back</a><% } %>
          <% } %>
          <div class="muted" style="font-size:0.78rem"><%= locals.relTime(n.created_at) %></div>
        </div>
      </div>
    <% }) %>
  <% } %>
<%- include('partials/footer') %>