<%- include('partials/header') %>
  <div class="card" style="max-width:820px;margin:0 auto;display:flex;justify-content:space-between;align-items:center">
    <h2 style="margin:0">Reports</h2>
    <a class="btn ghost small" href="/admin"><%- include('partials/icon', { name: 'arrowLeft', size: 14 }) %> Back to admin</a>
  </div>
  <% if (!reports.length) { %>
    <div class="card empty-state" style="max-width:820px;margin:0 auto"><div class="empty-art"><%- include('partials/rings', { size: 48, animate: true }) %></div><p>No pending reports.</p></div>
  <% } %>
  <% reports.forEach(function(r) { %>
    <div class="card" style="max-width:820px;margin:12px auto;border-left:3px solid var(--danger)">
      <div style="display:flex;justify-content:space-between;align-items:start;gap:12px;flex-wrap:wrap">
        <div style="font-size:var(--fs-sm)">
          <strong>Room:</strong> <%= r.room_name %> ·
          <strong>Reported:</strong> <a href="/u/<%= encodeURIComponent(r.username) %>"><%= r.display_name %></a> @<%= r.username %>
          · <strong>By:</strong> <%= r.reporter_name %> @<%= r.reporter_username %>
        </div>
        <small class="muted"><%= new Date(r.created_at).toLocaleString() %></small>
      </div>
      <div style="margin:10px 0;padding:10px 12px;background:var(--surface-2);border:1px solid var(--border-soft);border-radius:var(--radius-lg)">
        <em>"<%= r.message_body %>"</em>
      </div>
      <div style="margin-bottom:10px;font-size:var(--fs-sm)"><strong>Reason:</strong> <%= r.reason %></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <form method="post" action="/admin/reports/<%= r.id %>/ban">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn danger small"><%- include('partials/icon', { name: 'trash', size: 13 }) %> Ban <%= r.display_name %></button>
        </form>
        <form method="post" action="/admin/reports/<%= r.id %>/dismiss">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn ghost small">Dismiss</button>
        </form>
      </div>
    </div>
  <% }) %>
<script src="/static/admin.js?v=1"></script>
<%- include('partials/footer') %>