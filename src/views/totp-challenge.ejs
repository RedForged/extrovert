<%- include('partials/header', { pageTitle: 'Log in' }) %>

<div style="max-width:420px;margin:0 auto">
  <div class="card elevated" style="padding:28px">
    <h2>Two-factor authentication</h2>
    <p class="muted" style="font-size:0.9rem;margin:8px 0 16px">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>

    <% if (locals.error) { %>
      <div class="flash err"><span class="flash-ico"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span><span><%= error %></span></div>
    <% } %>

    <form method="post" action="/login/totp">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="code" class="muted" style="font-size:0.85rem">Authentication code</label>
      <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
             pattern="[0-9A-Za-z\- ]*" autofocus
             placeholder="123456 or recovery code"
             style="width:100%;margin-bottom:12px;font-size:1.15rem;letter-spacing:0.08em;text-align:center">
      <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;margin-bottom:14px;cursor:pointer">
        <input type="checkbox" name="remember" value="1" <%= locals.remember ? 'checked' : '' %>>
        Remember this device for 30 days
      </label>
      <button type="submit" class="btn full"><%- include('partials/icon', { name: 'lock', size: 15 }) %> Verify</button>
    </form>
    <p class="muted center" style="margin-top:14px"><a href="/login">Back to log in</a></p>
  </div>
</div>

<%- include('partials/footer') %>
