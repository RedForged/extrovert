<%- include('partials/header', { headCss: css, headCssId: 'ev-user-css', headFontCss: fontCss }) %>
<div class="pfx-page" data-profile-effect="<%= effect || '' %>">
  <%- pageHtml %>
</div>
<% if (isOwn) { %>
  <div class="ev-fields" id="ev-fields" data-font-family="<%= editor.customFont ? editor.customFont.family : '' %>">
    <h3 class="ev-fields-title">Profile</h3>

    <label class="ev-flabel">Avatar</label>
    <div class="ev-avatar-row">
      <% if (currentUser.avatar) { %><img src="<%= currentUser.avatar %>" alt="" class="avatar-preview"><% } else { %><div class="avatar-preview"><%= (currentUser.display_name || '?').slice(0, 1).toUpperCase() %></div><% } %>
      <form method="post" action="/u/<%= currentUser.username %>/avatar" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" name="avatar" accept="image/*" required style="display:none" id="avatarInput">
        <button class="btn ghost small" type="button" id="avatarUploadBtn"><%- include('partials/icon', { name: 'image', size: 13 }) %> Upload</button>
      </form>
      <% if (currentUser.avatar) { %>
        <form method="post" action="/u/<%= currentUser.username %>/avatar/remove">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn ghost danger small"><%- include('partials/icon', { name: 'trash', size: 12 }) %> Remove</button>
        </form>
      <% } %>
    </div>

    <label for="ev-displayName">Display name</label>
    <input type="text" id="ev-displayName" data-ev-field="displayName" value="<%= editor.displayName %>" maxlength="60">

    <label for="ev-bio">Bio</label>
    <textarea id="ev-bio" data-ev-field="bio" rows="3" maxlength="280"><%= editor.bio %></textarea>

    <label>Pronouns</label>
    <div class="pronoun-rows" id="pronounRows" data-max="<%= editor.pronounFieldsMax %>">
      <% var pronounFields = editor.pronouns.slice(); while (pronounFields.length < 2) pronounFields.push(''); %>
      <% pronounFields.forEach(function(p, i) { %>
        <div class="pronoun-row">
          <input type="text" name="pronoun" maxlength="<%= editor.pronounLengthMax %>" value="<%= p %>" placeholder="<%= i === 0 ? 'he/him' : 'they/them' %>" aria-label="Pronouns field <%= i + 1 %>">
          <button type="button" class="btn ghost small pronoun-remove" aria-label="Remove this field"<%= i < 2 ? ' hidden' : '' %>>&times;</button>
        </div>
      <% }); %>
    </div>
    <button type="button" class="btn ghost small" id="pronounAdd"><%- include('partials/icon', { name: 'plus', size: 12 }) %> Add field</button>

    <label for="ev-effect">Profile effect</label>
    <select id="ev-effect" data-ev-field="effect">
      <option value="" <%= !effect ? 'selected' : '' %>>None</option>
      <option value="matrix" <%= effect === 'matrix' ? 'selected' : '' %>>Matrix</option>
      <option value="glitch" <%= effect === 'glitch' ? 'selected' : '' %>>Glitch</option>
    </select>

    <label class="ev-flabel">Custom font</label>
    <% if (editor.customFont) { %>
      <div class="font-row">
        <span class="font-current"><%= editor.customFont.name %></span>
        <form method="post" action="/u/<%= currentUser.username %>/font/remove">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn ghost danger small"><%- include('partials/icon', { name: 'trash', size: 12 }) %> Remove</button>
        </form>
      </div>
      <small class="muted">Usable as &ldquo;<%= editor.customFont.family %>&rdquo; — it's in the Font menu and via CSS.</small>
    <% } %>
    <form method="post" action="/u/<%= currentUser.username %>/font" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="font" accept=".woff2,.woff,.ttf,.otf" required>
      <button class="btn ghost small"><%= editor.customFont ? 'Replace font' : 'Upload font' %></button>
    </form>

    <details class="ev-html">
      <summary>HTML</summary>
      <textarea id="ev-html-box" spellcheck="false" rows="12"><%= editor.templateHtml %></textarea>
      <small class="muted">Add or move blocks, links and images. Your live content (posts, header) shows as placeholders here until you reload.</small>
    </details>
  </div>
  <a id="ev-edit-toggle" class="btn ghost ev-edit-toggle" href="/u/<%= currentUser.username %>?edit=1"><%- include('partials/icon', { name: 'code', size: 15 }) %> Edit styles</a>
  <script src="/static/avatar.js?v=1"></script>
  <script src="/static/pronouns.js?v=1"></script>
  <script src="/static/profile-editor.js?v=10"></script>
<% } %>
<script src="/static/profile-effects.js?v=10"></script>
<%- include('partials/footer') %>
