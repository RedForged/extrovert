<%- include('partials/header') %>
  <div class="card" style="max-width:820px;margin:0 auto">
    <div style="display:flex;align-items:center;gap:2em;margin-bottom:18px;flex-wrap:wrap">
      <h2 style="margin:0">Admin · Users</h2>
      <span style="margin-left:auto;display:flex;gap:8px">
        <a class="btn small" href="/admin/mail">
          <%- include('partials/icon', { name: 'key', size: 14 }) %>
          Mail &amp; verification
        </a>
        <a class="btn small" href="/admin/announcement">
          <%- include('partials/icon', { name: 'megaphone', size: 14 }) %>
          Announcement
        </a>
      </span>
    </div>
    <table class="admin-table">
      <thead>
        <tr><th>User</th><th>Referred</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td>
              <a href="/u/<%= u.username %>"><%= u.display_name %></a>
              <small class="muted">@<%= u.username %></small>
            </td>
            <td><%= u.referral_count %><% if (u.referral_count > 0) { %> <%- include('partials/icon', { name: 'starFilled', size: 12, cls: 'flash-ico' }) %><% } %></td>
            <td>
              <% if (u.banned) { %><span style="color:var(--danger);font-weight:600">Banned</span><% } else if (u.is_admin) { %><span style="color:var(--accent);font-weight:600">Admin</span><% } else { %><span class="muted">Active</span><% } %>
            </td>
            <td class="actions">
              <% if (!u.is_admin) { %>
                <form method="post" action="/admin/make-admin/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" style="color:var(--accent)">Make admin</button></form>
                <form method="post" action="/admin/delete/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost danger small">Delete</button></form>
                <% if (u.banned) { %>
                  <form method="post" action="/admin/unban/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small">Unban</button></form>
                <% } else { %>
                  <form method="post" action="/admin/ban/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small">Ban</button></form>
                <% } %>
              <% } %>
              <% if (u.referral_count > 0) { %>
                <form method="post" action="/admin/remove-referral/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small">Remove ★</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card" style="max-width:820px;margin:16px auto" id="rooms">
    <h2>Admin · Rooms</h2>
    <% if (rooms.length) { %>
      <table class="admin-table">
        <thead><tr><th>Room</th><th>Creator</th><th>Members</th><th>Type</th><th>Actions</th></tr></thead>
        <tbody>
          <% rooms.forEach(function(r) { %>
            <tr>
              <td><a href="/rooms/<%= r.id %>"><%= r.name %></a><small class="muted"><%= r.description ? r.description.substring(0, 60) : '' %></small></td>
              <td><%= r.creator_username || '—' %></td>
              <td><%= r.member_count %></td>
              <td><span class="muted"><%= r.is_public ? 'Public' : 'Private' %></span></td>
              <td class="actions">
                <form method="post" action="/admin/rooms/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost danger small">Delete</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">No rooms.</p>
    <% } %>
  </div>

  <div class="card" style="max-width:820px;margin:16px auto">
    <h2>Admin · Security reports</h2>
    <p class="muted" style="margin:-4px 0 10px">Private responsible-disclosure submissions from the <a href="/security">/security</a> page.</p>
    <% if ((locals.securityReports || 0) > 0) { %>
      <a class="btn" href="/admin/security-reports"><%- include('partials/icon', { name: 'lock', size: 14 }) %> Review <%= securityReports %> open report<%= securityReports === 1 ? '' : 's' %></a>
    <% } else { %>
      <a class="btn ghost" href="/admin/security-reports"><%- include('partials/icon', { name: 'lock', size: 14 }) %> Security inbox</a>
    <% } %>
  </div>

  <div class="card" style="max-width:820px;margin:16px auto" id="reports">
    <h2>Admin · Reports (<%= reports.length %>)</h2>
    <% if (reports.length) { %>
      <table class="admin-table">
        <thead><tr><th>Message</th><th>From</th><th>Room</th><th>Actions</th></tr></thead>
        <tbody>
          <% reports.forEach(function(r) { %>
            <tr>
              <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= r.message_body %></td>
              <td><%= r.reporter_username %></td>
              <td><%= r.room_name %></td>
              <td class="actions">
                <form method="post" action="/admin/reports/<%= r.id %>/ban"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost danger small">Ban author</button></form>
                <form method="post" action="/admin/reports/<%= r.id %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small">Dismiss</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">No pending reports.</p>
    <% } %>
  </div>
<script src="/static/admin.js?v=1"></script>
<%- include('partials/footer') %>