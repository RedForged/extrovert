<%
  const auditLabels = {
    user_banned: 'Banned a user',
    user_unbanned: 'Unbanned a user',
    user_promoted: 'Promoted an admin',
    user_deleted: 'Deleted a user',
    room_deleted: 'Deleted a room',
    referral_badge_removed: 'Removed a referral boost',
    report_content_removed: 'Removed reported content',
    report_dismissed: 'Dismissed a report',
    security_report_handled: 'Handled a security report',
    profile_updated: 'Updated a profile',
    post_deleted: 'Deleted a post',
    room_message_deleted: 'Deleted a room message'
  };
  const openReports = pendingReports + openSecurity;
  const attention = [];
  if (pendingReports > 0) attention.push({ href: '/admin/reports', icon: 'flag', label: 'Pending content reports', count: pendingReports });
  if (openSecurity > 0) attention.push({ href: '/admin/security-reports', icon: 'lock', label: 'Open security reports', count: openSecurity });
  if (overQuota > 0) attention.push({ href: '/admin/storage', icon: 'cloud', label: 'Users over their Drive quota', count: overQuota });
  if (lastMail && !lastMail.delivered) attention.push({ href: '/admin/mail', icon: 'key', label: 'Last verification email was not delivered', count: 1 });
%>
<%- include('partials/header', { wrapClass: 'wrap-admin' }) %>
<div class="admin-shell">
  <%- include('partials/admin-sidebar', { active: 'overview' }) %>
  <div class="admin-main">
    <header class="admin-page-head">
      <div>
        <h1>Overview</h1>
        <p>Instance health, moderation and storage at a glance.</p>
      </div>
      <a class="btn ghost small" href="/"><%- include('partials/icon', { name: 'arrowLeft', size: 14 }) %> View site</a>
    </header>

    <section class="admin-stats" aria-label="Site totals">
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'users', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value"><%= totalUsers %></div>
          <div class="admin-stat-label">Users</div>
          <div class="admin-stat-sub">+<%= newUsers %> this week · <%= admins %> admin<%= admins === 1 ? '' : 's' %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'rooms', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value"><%= totalRooms %></div>
          <div class="admin-stat-label">Rooms</div>
          <div class="admin-stat-sub"><%= roomMembers %> membership<%= roomMembers === 1 ? '' : 's' %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'doc', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value"><%= totalPosts %></div>
          <div class="admin-stat-label">Posts</div>
          <div class="admin-stat-sub"><%= totalComments %> comment<%= totalComments === 1 ? '' : 's' %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'flag', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value"><%= openReports %></div>
          <div class="admin-stat-label">Open reports</div>
          <div class="admin-stat-sub"><%= pendingReports %> content · <%= openSecurity %> security</div>
        </div>
      </div>
    </section>

    <div class="admin-grid">
      <div class="admin-stack">
        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Needs attention</h2>
            <% if (pendingReports > 0) { %><a class="admin-panel-link" href="/admin/reports">Review queue</a>
            <% } else if (openSecurity > 0) { %><a class="admin-panel-link" href="/admin/security-reports">Security inbox</a><% } %>
          </div>
          <div class="admin-attention">
            <% if (!attention.length) { %>
              <div class="admin-attention-item ok">
                <span class="admin-attention-icon"><%- include('partials/icon', { name: 'check', size: 16 }) %></span>
                <span>Nothing needs attention right now.</span>
              </div>
            <% } %>
            <% attention.forEach(function(item) { %>
              <a class="admin-attention-item" href="<%= item.href %>">
                <span class="admin-attention-icon"><%- include('partials/icon', { name: item.icon, size: 16 }) %></span>
                <span><%= item.label %></span>
                <span class="admin-attention-count"><%= item.count %></span>
              </a>
            <% }); %>
          </div>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Recent moderation activity</h2>
            <a class="admin-panel-link" href="/admin/reports">Reports</a>
          </div>
          <% if (recentAudit.length) { %>
            <div class="admin-list">
              <% recentAudit.forEach(function(a) { %>
                <div class="admin-list-row">
                  <span class="admin-list-icon"><%- include('partials/icon', { name: 'shield', size: 14 }) %></span>
                  <div class="admin-list-main">
                    <strong><%= auditLabels[a.action] || String(a.action || '').replace(/_/g, ' ') %></strong>
                    <small><%= a.display_name || a.username || 'System' %><% if (a.details) { %> · <%= a.details %><% } %></small>
                  </div>
                  <span class="admin-list-time"><%= locals.relTime(a.created_at) %></span>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="admin-empty">No admin activity logged yet.</p>
          <% } %>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Site announcement</h2>
            <a class="admin-panel-link" href="/admin/announcement"><%= announcement ? 'Edit' : 'Publish' %></a>
          </div>
          <% if (announcement) { %>
            <p class="admin-announcement-body"><%= announcement.body %></p>
            <small class="muted">
              <% if (announcement.author_display_name || announcement.author_username) { %>by <%= announcement.author_display_name || announcement.author_username %> · <% } %>
              updated <%= locals.relTime(announcement.updated_at) %>
            </small>
          <% } else { %>
            <p class="admin-empty">No announcement is pinned to the top bar.</p>
          <% } %>
        </section>
      </div>

      <div class="admin-stack">
        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Storage</h2>
            <a class="admin-panel-link" href="/admin/storage">Manage</a>
          </div>
          <div class="admin-storage-total">
            <strong><%= fmt(storage.bytes) %></strong>
            <span class="muted">in <%= storage.files %> file<%= storage.files === 1 ? '' : 's' %></span>
          </div>
          <div class="usage-bar" role="progressbar" aria-valuenow="<%= storagePercent %>" aria-valuemin="0" aria-valuemax="100">
            <span style="width:<%= storagePercent %>%"></span>
          </div>
          <p class="admin-panel-note"><%= storagePercent %>% of the aggregate per-user quota<%= quota ? ' (' + fmt(quota) + ' per user)' : '' %>.</p>
          <% if (topStorage.length) { %>
            <div class="admin-list">
              <% topStorage.forEach(function(row) { %>
                <div class="admin-list-row">
                  <span class="admin-list-icon"><%- include('partials/icon', { name: 'cloud', size: 14 }) %></span>
                  <div class="admin-list-main">
                    <strong>@<%= row.username %></strong>
                    <small><%= row.files %> file<%= row.files === 1 ? '' : 's' %></small>
                  </div>
                  <span class="admin-list-time"><%= fmt(row.bytes) %></span>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="admin-empty">No files stored on this server yet.</p>
          <% } %>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Recent signups</h2>
            <a class="admin-panel-link" href="/admin/users">All users</a>
          </div>
          <% if (recentUsers.length) { %>
            <div class="admin-list">
              <% recentUsers.forEach(function(u) { %>
                <div class="admin-list-row">
                  <span class="admin-avatar">
                    <% if (u.avatar) { %><img src="<%= u.avatar %>" alt=""><% } else { %><%= String(u.display_name || u.username || '?').slice(0, 1).toUpperCase() %><% } %>
                  </span>
                  <div class="admin-list-main">
                    <strong><a href="/u/<%= encodeURIComponent(u.username) %>"><%= u.display_name || u.username %></a></strong>
                    <small>@<%= u.username %><% if (u.is_admin) { %> · admin<% } else if (u.banned) { %> · banned<% } %></small>
                  </div>
                  <span class="admin-list-time"><%= locals.relTime(u.created_at) %></span>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="admin-empty">No accounts yet.</p>
          <% } %>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Recent rooms</h2>
            <a class="admin-panel-link" href="/admin/rooms">All rooms</a>
          </div>
          <% if (recentRooms.length) { %>
            <div class="admin-list">
              <% recentRooms.forEach(function(r) { %>
                <div class="admin-list-row">
                  <span class="admin-list-icon"><%- include('partials/icon', { name: 'rooms', size: 14 }) %></span>
                  <div class="admin-list-main">
                    <strong><a href="/rooms/<%= r.id %>"><%= r.name %></a></strong>
                    <small><%= r.is_public ? 'Public' : 'Private' %> · <%= r.member_count %> member<%= r.member_count === 1 ? '' : 's' %><% if (r.creator_username) { %> · @<%= r.creator_username %><% } %></small>
                  </div>
                  <span class="admin-list-time"><%= locals.relTime(r.created_at) %></span>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="admin-empty">No rooms yet.</p>
          <% } %>
        </section>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
