<%- include('partials/header', { wrapClass: 'wrap-admin' }) %>
<div class="admin-shell">
  <%- include('partials/admin-sidebar', { active: 'security' }) %>
  <div class="admin-main">
    <header class="admin-page-head">
      <div>
        <h1>Security reports</h1>
        <p><%= reports.filter(function(r) { return r.status === 'open'; }).length %> open · private responsible-disclosure submissions from the public <a href="/security">/security</a> page.</p>
      </div>
    </header>

    <% if (reports.length === 0) { %>
      <div class="card empty-state"><p>No security reports.</p></div>
    <% } else { %>
      <% reports.forEach(function(r) { %>
        <div class="card admin-panel">
          <div class="admin-report-head">
            <div class="admin-report-title">
              <strong><%= r.summary %></strong>
              <span class="admin-status<%= r.status === 'open' ? ' banned' : '' %>" style="margin-left:8px"><%= r.status %></span>
            </div>
            <% if (r.status === 'open') { %>
              <form method="post" action="/admin/security-reports/<%= r.id %>/handle">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn ghost small">Mark handled</button>
              </form>
            <% } %>
          </div>
          <div class="muted admin-report-meta">
            <%= new Date(r.created_at).toLocaleString() %>
            <% if (r.reporter_name) { %> · <%= r.reporter_name %><% } %>
            <% if (r.reporter_contact) { %> · <%= r.reporter_contact %><% } %>
            <% if (r.handled_by_username) { %> · handled by <%= r.handled_by_username %><% } %>
          </div>
          <pre class="admin-report-details"><%= r.details %></pre>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
