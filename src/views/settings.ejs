<%
  const emailValue = emailStatus.policy === 'off' ? 'Off' : emailStatus.verified ? 'Verified' : emailStatus.email ? 'Unverified' : 'Not set';
  const emailSub = emailStatus.policy === 'off' ? 'Verification disabled' : emailStatus.email || 'Add an address';
  const twofaValue = !totpKeyConfigured ? 'N/A' : totpEnabled ? 'On' : 'Off';
  const twofaSub = !totpKeyConfigured ? 'Not configured on this server' : totpEnabled ? unusedRecoveryCodes + ' recovery codes left' : 'Authenticator app';
  const storageValue = fmt(usage.unlimited ? usage.used : usage.localUsed);
  const storageSub = usage.unlimited ? 'Stored in your Nextcloud' : 'of ' + fmt(usage.quota);
  const connectionLabel = !nextcloud ? 'Not connected' : nextcloud.enabled ? 'Connected' : 'Paused';
%>
<%- include('partials/header', { wrapClass: 'wrap-settings' }) %>
<header class="admin-page-head">
  <div>
    <h1>Settings</h1>
    <p>Your account, security and connected services.</p>
  </div>
  <a class="btn ghost small" href="/u/<%= encodeURIComponent(currentUser.username) %>?edit=1"><%- include('partials/icon', { name: 'edit', size: 14 }) %> Edit profile</a>
</header>
<div class="admin-shell">
  <%- include('partials/settings-sidebar', { active: 'overview' }) %>
  <div class="admin-main">
    <section class="admin-stats" aria-label="Account summary">
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'at', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value settings-stat-text"><%= emailValue %></div>
          <div class="admin-stat-label">Email</div>
          <div class="admin-stat-sub"><%= emailSub %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'lock', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value settings-stat-text"><%= twofaValue %></div>
          <div class="admin-stat-label">Two-factor</div>
          <div class="admin-stat-sub"><%= twofaSub %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'key', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value"><%= passkeys.length %></div>
          <div class="admin-stat-label">Passkeys</div>
          <div class="admin-stat-sub"><%= passkeys.length ? 'Passwordless sign-in' : 'Add one for faster sign-in' %></div>
        </div>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-icon"><%- include('partials/icon', { name: 'cloud', size: 18 }) %></span>
        <div>
          <div class="admin-stat-value settings-stat-text"><%= storageValue %></div>
          <div class="admin-stat-label">Storage</div>
          <div class="admin-stat-sub"><%= storageSub %></div>
        </div>
      </div>
    </section>

    <div class="admin-grid">
      <div class="admin-stack">
        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Account</h2>
            <a class="admin-panel-link" href="/settings/account">Manage</a>
          </div>
          <div class="admin-list">
            <div class="admin-list-row">
              <span class="admin-avatar settings-avatar">
                <% if (currentUser.avatar) { %><img src="<%= currentUser.avatar %>" alt=""><% } else { %><%= String(currentUser.display_name || currentUser.username || '?').slice(0, 1).toUpperCase() %><% } %>
              </span>
              <div class="admin-list-main">
                <strong><%= currentUser.display_name || currentUser.username %></strong>
                <small>@<%= currentUser.username %> · joined <%= locals.relTime(currentUser.created_at) %></small>
              </div>
            </div>
            <div class="admin-list-row">
              <span class="admin-list-icon"><%- include('partials/icon', { name: 'at', size: 14 }) %></span>
              <div class="admin-list-main">
                <strong><%= emailValue %></strong>
                <small><%= emailStatus.email || 'No email address on file' %></small>
              </div>
              <a class="admin-panel-link" href="/settings/account">Manage</a>
            </div>
            <div class="admin-list-row">
              <span class="admin-list-icon"><%- include('partials/icon', { name: 'key', size: 14 }) %></span>
              <div class="admin-list-main">
                <strong><%= devices.length %> active device<%= devices.length === 1 ? '' : 's' %></strong>
                <small>Devices registered for encrypted messaging</small>
              </div>
              <a class="admin-panel-link" href="/settings/devices">Manage</a>
            </div>
          </div>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Security checkup</h2>
            <a class="admin-panel-link" href="/settings/security">Open security</a>
          </div>
          <div class="admin-attention">
            <% if (emailStatus.policy === 'off') { %>
              <div class="admin-attention-item info"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'at', size: 16 }) %></span><span>Email verification is disabled on this server.</span></div>
            <% } else if (emailStatus.verified) { %>
              <div class="admin-attention-item ok"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'check', size: 16 }) %></span><span>Email address verified.</span></div>
            <% } else { %>
              <a class="admin-attention-item" href="/settings/account"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'alert', size: 16 }) %></span><span><%= emailStatus.email ? 'Verify your email address' : 'Add and verify an email address' %></span><span class="admin-attention-count">Action</span></a>
            <% } %>

            <% if (!totpKeyConfigured) { %>
              <div class="admin-attention-item info"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'lock', size: 16 }) %></span><span>Two-factor authentication is not configured on this server.</span></div>
            <% } else if (totpEnabled) { %>
              <div class="admin-attention-item ok"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'check', size: 16 }) %></span><span>Two-factor authentication is on · <%= unusedRecoveryCodes %> recovery codes left.</span></div>
            <% } else { %>
              <a class="admin-attention-item" href="/settings/security"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'alert', size: 16 }) %></span><span>Turn on two-factor authentication</span><span class="admin-attention-count">Action</span></a>
            <% } %>

            <% if (passkeys.length) { %>
              <div class="admin-attention-item ok"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'check', size: 16 }) %></span><span><%= passkeys.length %> passkey<%= passkeys.length === 1 ? '' : 's' %> registered.</span></div>
            <% } else { %>
              <a class="admin-attention-item" href="/settings/security"><span class="admin-attention-icon"><%- include('partials/icon', { name: 'alert', size: 16 }) %></span><span>Add a passkey for passwordless sign-in</span><span class="admin-attention-count">Action</span></a>
            <% } %>
          </div>
        </section>
      </div>

      <div class="admin-stack">
        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Storage</h2>
            <a class="admin-panel-link" href="/settings/drive">Manage</a>
          </div>
          <div class="admin-storage-total">
            <strong><%= storageValue %></strong>
            <span class="muted"><%= usage.unlimited ? 'stored in your Nextcloud' : 'of ' + fmt(usage.quota) + ' on this server' %></span>
          </div>
          <% if (!usage.unlimited) { %>
            <div class="usage-bar" role="progressbar" aria-valuenow="<%= usedPercent %>" aria-valuemin="0" aria-valuemax="100">
              <span style="width:<%= usedPercent %>%"></span>
            </div>
            <p class="admin-panel-note"><%= usedPercent %>% of your Drive quota used.</p>
          <% } else { %>
            <p class="admin-panel-note">New uploads go to your Nextcloud, so the local Drive quota does not apply.</p>
          <% } %>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
            <a class="btn ghost small" href="/drive"><%- include('partials/icon', { name: 'image', size: 14 }) %> Open Drive</a>
            <a class="btn ghost small" href="/settings/drive"><%- include('partials/icon', { name: 'cloud', size: 14 }) %> Storage settings</a>
          </div>
          <p class="admin-panel-note" style="margin-top:12px">Nextcloud: <strong><%= connectionLabel %></strong><%= nextcloud ? ' · ' + nextcloud.baseUrl : '' %></p>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Connected services</h2>
          </div>
          <div class="admin-list">
            <div class="admin-list-row">
              <span class="admin-list-icon"><%- include('partials/icon', { name: 'bot', size: 14 }) %></span>
              <div class="admin-list-main">
                <strong>Bots</strong>
                <small><%= botsCount %> bot<%= botsCount === 1 ? '' : 's' %> created</small>
              </div>
              <a class="admin-panel-link" href="/settings/bots">Manage</a>
            </div>
            <div class="admin-list-row">
              <span class="admin-list-icon"><%- include('partials/icon', { name: 'code', size: 14 }) %></span>
              <div class="admin-list-main">
                <strong>Developer applications</strong>
                <small><%= appsCount %> registered · <%= authorizedCount %> authorized</small>
              </div>
              <a class="admin-panel-link" href="/settings/developers">Manage</a>
            </div>
          </div>
        </section>

        <section class="card admin-panel">
          <div class="admin-panel-head">
            <h2>Active devices</h2>
            <a class="admin-panel-link" href="/settings/devices">Manage</a>
          </div>
          <% if (devices.length) { %>
            <div class="admin-list">
              <% devices.slice(0, 4).forEach(function(dev) { %>
                <div class="admin-list-row">
                  <span class="admin-list-icon"><%- include('partials/icon', { name: 'key', size: 14 }) %></span>
                  <div class="admin-list-main">
                    <strong><%= dev.device_name || 'Device' %></strong>
                    <small><% if (dev.last_seen_at) { %>last active <%= locals.relTime(dev.last_seen_at) %><% } else { %><%= String(dev.device_id || '').slice(0, 16) %>…<% } %></small>
                  </div>
                </div>
              <% }); %>
            </div>
            <% if (devices.length > 4) { %><p class="admin-panel-note"><%= devices.length - 4 %> more device<%= devices.length - 4 === 1 ? '' : 's' %>.</p><% } %>
          <% } else { %>
            <p class="admin-empty">No active devices yet.</p>
          <% } %>
          <div style="margin-top:12px">
            <a class="btn ghost small" href="/settings/devices"><%- include('partials/icon', { name: 'plus', size: 14 }) %> Pair a device</a>
          </div>
        </section>

        <p class="muted" style="font-size:var(--fs-xs);margin:2px 0 0">Extrovert — “Embrace” v<%= version %></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
