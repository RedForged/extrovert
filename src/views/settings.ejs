<%- include('partials/header') %>
  <div class="card" style="max-width:420px;margin:0 auto">
    <h2>Settings</h2>
    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="settings-theme">Theme</label>
      <select name="theme" id="settings-theme">
        <option value="dark" <%= theme === 'dark' ? 'selected' : '' %>>Dark · Ink</option>
        <option value="light" <%= theme === 'light' ? 'selected' : '' %>>Light · Lavender</option>
      </select>
      <label style="display:flex;align-items:center;gap:8px;margin-top:14px;cursor:pointer">
        <input type="checkbox" name="developer_mode" value="1" <%= developerMode ? 'checked' : '' %>>
        Developer settings — show security &amp; developer links in the navigation
      </label>
      <button class="btn full" style="margin-top:18px">Save</button>
    </form>
    <hr>
    <h4>Call notifications</h4>
    <p style="font-size:0.85rem;color:var(--text-muted);margin:-4px 0 8px">Wake this device with a ringing notification when someone calls you, even if you've closed the app. Works on desktop and Android Chrome; iOS requires adding Extrovert to your home screen.</p>
    <button id="push-toggle" class="btn ghost full" style="margin-bottom:8px" disabled>Loading…</button>
    <div id="push-status" style="font-size:0.8rem;color:var(--text-muted);margin-bottom:16px"></div>
    <script src="/static/settings.js" defer></script>
    <hr>
    <h4>Active devices</h4>
    <p style="font-size:0.85rem;color:var(--text-muted);margin:-4px 0 10px">Devices registered for end-to-end encrypted messaging.</p>
    <% if (devices && devices.length) { %>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px">
        <% devices.forEach(function(dev) { %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;font-size:0.85rem">
            <div>
              <div style="font-weight:600;color:var(--text-normal)"><%= dev.device_name || 'Device' %></div>
              <div style="font-size:0.75rem;color:var(--text-muted);font-family:monospace"><%= dev.device_id.slice(0, 16) %>…</div>
            </div>
            <form method="post" action="/settings/devices/<%= encodeURIComponent(dev.device_id) %>/delete" style="margin:0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn ghost danger" style="padding:4px 8px;font-size:0.75rem" onclick="return confirm('Revoke this device? It will no longer receive new messages.')">Revoke</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="muted" style="font-size:0.8rem;margin-bottom:14px">No active devices registered yet.</p>
    <% } %>
    <hr>
    <a class="btn ghost full" href="/settings/developers" style="margin-bottom:8px"><%- include('partials/icon', { name: 'key', size: 15 }) %> Developer applications</a>
    <a class="btn ghost full" href="/docs" style="margin-bottom:8px"><%- include('partials/icon', { name: 'doc', size: 15 }) %> Documentation</a>
    <a class="btn ghost full" href="/developers/docs" style="margin-bottom:8px"><%- include('partials/icon', { name: 'code', size: 15 }) %> API reference (Swagger UI)</a>
    <a class="btn ghost danger full" href="/settings/delete"><%- include('partials/icon', { name: 'trash', size: 15 }) %> Delete account</a>
    <div class="muted" style="text-align:center;font-size:0.75rem;margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
      Extrovert &mdash; &ldquo;Embrace&rdquo; v<%= version %>
    </div>
  </div>
<%- include('partials/footer') %>