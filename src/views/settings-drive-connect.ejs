<%- include('partials/header') %>
  <div class="card" style="max-width:560px;margin:0 auto">
    <h2 style="margin:0">Approve access in Nextcloud</h2>
    <p class="muted" style="font-size:var(--fs-sm);margin:8px 0 0">
      Connecting <strong><%= baseUrl %></strong>. Open Nextcloud, sign in if asked, and approve
      Extrovert. This page notices automatically — no password is typed here.
    </p>

    <% if (error) { %>
      <div class="flash err" style="margin:12px 0 0"><span class="flash-ico"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span><span><%= error %></span></div>
    <% } %>

    <a class="btn full" href="<%= loginUrl %>" target="_blank" rel="noopener noreferrer" style="margin-top:16px">
      Open Nextcloud to approve
    </a>

    <p id="drive-connect-status" class="muted" aria-live="polite" style="font-size:var(--fs-sm);margin:12px 0 0">
      Waiting for approval…
    </p>

    <form method="post" action="/settings/drive/connect/<%= encodeURIComponent(flowId) %>/poll" id="drive-connect-check" style="margin-top:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost small" type="submit">Check now</button>
      <a class="btn ghost small" href="/settings/drive">Cancel</a>
    </form>

    <p class="muted" style="font-size:var(--fs-xs);margin:14px 0 0">
      Approved it already? Press <strong>Check now</strong>. Nextcloud issues a revocable app
      password for Extrovert, so you can withdraw access at any time under
      <strong>Settings → Security → Devices &amp; sessions</strong> in Nextcloud.
    </p>
  </div>
  <script src="/static/drive-connect.js?v=1" defer></script>
<%- include('partials/footer') %>
