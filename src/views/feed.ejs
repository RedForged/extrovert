<%- include('partials/header', { wrapClass: 'feed-wrap' }) %>
<div class="feed-layout">
  <aside class="feed-sidebar feed-sidebar-left">
    <div class="card">
      <h4 style="margin:0 0 10px">My stickers</h4>
      <form method="post" action="/stickers/upload" enctype="multipart/form-data" style="margin-bottom:10px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" name="sticker" accept="image/*" required style="font-size:12px;width:100%">
        <button class="btn small" type="submit" style="margin-top:8px"><%- include('partials/icon', { name: 'plus', size: 14 }) %> Upload</button>
      </form>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% if (stickers.length) { %>
          <% stickers.forEach(function(s){ %>
            <img src="<%= s.file_path %>" alt="" style="width:56px;height:56px;object-fit:contain;border-radius:var(--radius-sm);background:var(--surface-3)">
          <% }) %>
        <% } else { %>
          <p class="muted" style="font-size:12px;margin:0">No stickers yet — drop one in and it'll show up here.</p>
        <% } %>
      </div>
      <% if (stickers.length) { %><a href="/stickers/manage" style="font-size:12px;display:inline-flex;align-items:center;gap:3px;margin-top:8px">Manage <%- include('partials/icon', { name: 'arrowRight', size: 12 }) %></a><% } %>
    </div>
  </aside>
  <div class="feed-main">
    <div class="card elevated" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap">
      <div>
        <h2 style="margin:0">Your feed</h2>
        <small class="muted">Only posts from you, your friends, and their friends.</small>
      </div>
      <a class="btn" href="/compose"><%- include('partials/icon', { name: 'plus', size: 16 }) %> New post</a>
    </div>

    <% if (!items.length) { %>
      <div class="card empty-state">
        <div class="empty-art"><%- include('partials/rings', { size: 64, animate: true }) %></div>
        <h4>Quiet here</h4>
        <p>Nobody in your network has posted yet. Break the ice.</p>
        <a class="btn" href="/compose"><%- include('partials/icon', { name: 'plus', size: 16 }) %> Write the first post</a>
      </div>
    <% } else { %>
      <%- include('partials/post-list', { items: items }) %>
      <div class="pager">
        <span class="pager-side">
          <% if (page > 1) { %>
            <a class="btn ghost" href="/?page=<%= page - 1 %>"><%- include('partials/icon', { name: 'arrowLeft', size: 15 }) %> Newer</a>
          <% } %>
        </span>
        <span class="page-indicator">Page <%= page %></span>
        <span class="pager-side">
          <% if (hasMore) { %>
            <a class="btn ghost" href="/?page=<%= page + 1 %>">Older <%- include('partials/icon', { name: 'arrowRight', size: 15 }) %></a>
          <% } %>
        </span>
      </div>
    <% } %>
  </div>
  <aside class="feed-sidebar feed-sidebar-right">
    <div class="card">
      <div class="section-rings">
        <%- include('partials/rings', { size: 20 }) %>
        <h4 style="margin:0">Find people</h4>
      </div>
      <form method="get" action="/">
        <input type="search" name="q" value="<%= q %>" placeholder="Search by username…" style="font-size:13px;width:100%">
      </form>
      <% if (discoverResults.length) { %>
        <div style="margin-top:10px">
          <% discoverResults.forEach(function(r){ %>
            <div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--border-soft)">
              <% if (r.avatar) { %><img src="<%= r.avatar %>" alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover"><% } else { %><div style="width:30px;height:30px;border-radius:50%;background:var(--primary-soft);color:var(--primary-strong);display:flex;align-items:center;justify-content:center;font-size:12px;font-family:var(--font-display);flex-shrink:0"><%= r.username.slice(0,1).toUpperCase() %></div><% } %>
              <div style="flex:1;min-width:0;font-size:13px">
                <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600"><%= r.display_name %></div>
                <small class="muted">@<%= r.username %></small>
              </div>
              <a class="btn small" href="/u/<%= r.username %>">View</a>
            </div>
          <% }) %>
        </div>
      <% } %>
      <div class="section-rings" style="margin-top:16px">
        <%- include('partials/rings', { size: 20 }) %>
        <small class="muted" style="font-weight:700;letter-spacing:0.04em;text-transform:uppercase;font-size:11px">Friends of friends</small>
      </div>
      <% if (suggested.length) { %>
        <% suggested.forEach(function(r){ %>
          <div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--border-soft)">
            <% if (r.avatar) { %><img src="<%= r.avatar %>" alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover"><% } else { %><div style="width:30px;height:30px;border-radius:50%;background:var(--secondary-soft);color:var(--secondary-strong);display:flex;align-items:center;justify-content:center;font-size:12px;font-family:var(--font-display);flex-shrink:0"><%= r.username.slice(0,1).toUpperCase() %></div><% } %>
            <div style="flex:1;min-width:0;font-size:13px">
              <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600"><%= r.display_name %></div>
              <small class="muted">@<%= r.username %></small>
            </div>
            <a class="btn ghost small" href="/u/<%= r.username %>">View</a>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted" style="font-size:12px;margin:6px 0 0">Your friends haven't introduced you to anyone new yet. Follow a couple more people to widen the ring.</p>
      <% } %>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>