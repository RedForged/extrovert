<%- include('../partials/header', { wrapClass: 'room-wrap' }) %>
<% if (room.css) { %><style><%= room.css %></style><% } %>
<div class="room-layout">
  <aside class="room-sidebar">
    <div class="room-sidebar-header">
      <strong><%= room.name %></strong>
      <small class="muted"><%= members.length %> member<%= members.length !== 1 ? 's' : '' %></small>
    </div>
    <nav class="room-channel-list" id="channel-list">
      <% channels.forEach(function(ch) { %>
        <% if (ch.type === 'voice') { %>
          <div class="room-channel voice-channel" data-channel-id="<%= ch.id %>" data-channel-type="voice">
            <%- include('../partials/icon', { name: 'mic', size: 14 }) %> <span class="voice-name"><%= ch.name %></span>
            <span class="voice-count" id="voice-count-<%= ch.id %>"><%= voiceChannelMembers && voiceChannelMembers[ch.id] ? voiceChannelMembers[ch.id].length : 0 %></span>
            <button class="voice-join-btn" data-channel-id="<%= ch.id %>">Join</button>
          </div>
          <div class="voice-members active" id="voice-members-<%= ch.id %>">
            <% if (voiceChannelMembers && voiceChannelMembers[ch.id]) { %>
              <% voiceChannelMembers[ch.id].forEach(function(m) { %>
                <div class="voice-member" id="voice-member-<%= ch.id %>-<%= m.username %>"<% if (m.username === locals.currentUser.username) { %> data-self="1"<% } %>>
                  <span class="voice-member-speaking"><%- include('../partials/icon', { name: 'speaker', size: 12 }) %></span><span class="voice-member-name"><%= m.display_name || m.username %></span><% if (m.username === locals.currentUser.username) { %> <span class="voice-member-you">you</span><% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        <% } else { %>
          <a href="#" class="room-channel<%= firstChannel && ch.id === firstChannel.id ? ' active' : '' %>" data-channel-id="<%= ch.id %>">
            # <span><%= ch.name %></span>
          </a>
        <% } %>
      <% }) %>
    </nav>
    <div class="room-sidebar-actions">
      <details class="menu-dd" open>
        <summary title="Room menu"><%- include('../partials/icon', { name: 'more', size: 18 }) %></summary>
        <div class="menu-dd-pop">
      <% if (role && (role.permissions & 64)) { %><a href="/rooms/<%= room.id %>/settings" class="room-sidebar-link">Settings</a><% } %>
      <% if (role && (role.permissions & 4)) { %><a href="/rooms/<%= room.id %>/channels" class="room-sidebar-link">Channels</a><% } %>
      <% if (role && (role.permissions & 8)) { %><a href="/rooms/<%= room.id %>/roles" class="room-sidebar-link">Roles</a><% } %>
      <% if (role && (role.permissions & 32)) { %><a href="/rooms/<%= room.id %>/members" class="room-sidebar-link">Members</a><% } %>
      <% if (role && (role.is_founder || locals.currentUser && locals.currentUser.is_admin)) { %><a href="/rooms/<%= room.id %>/settings" class="room-sidebar-link danger">Delete Room</a><% } else { %><form method="post" action="/rooms/<%= room.id %>/leave" style="margin:0" data-confirm="Leave this room?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="room-sidebar-link danger" style="background:none;border:none;cursor:pointer">Leave</button></form><% } %>
        </div>
      </details>
    </div>
  </aside>
  <main class="room-main">
    <% if (room.html) { %><div class="room-banner"><%- room.html %></div><% } %>
    <div class="room-channel-header" id="channel-header">
      # <span id="channel-name"><%= firstChannel ? firstChannel.name : '' %></span>
    </div>
    <div class="room-messages" id="room-messages" data-channel-id="<%= firstChannel ? firstChannel.id : '' %>" data-room-id="<%= room.id %>" data-user-id="<%= locals.currentUser.id %>">
      <% messages.forEach(function(m) { %>
        <% var mRole = roles.find(function(r) { var mem = members.find(function(mm) { return mm.user_id === m.user_id; }); return mem && mem.role_id === r.id; }); %>
        <div class="room-msg<%= m.user_id === locals.currentUser.id ? ' self' : '' %>" data-msg-id="<%= m.id %>"<% if (m.proto === 'mls') { %> data-proto="mls" data-sender-id="<%= m.user_id %>" data-ciphertext="<%= m.ciphertext || '' %>"<% } %>>
          <div class="room-msg-body">
            <div class="room-msg-row">
              <div class="room-msg-avatar-wrap">
                <% if (m.avatar) { %><img src="<%= m.avatar %>" alt="" class="room-msg-avatar"><% } else { %><span class="room-msg-avatar room-msg-avatar-letter"><%= (m.display_name || m.username)[0].toUpperCase() %></span><% } %>
              </div>
              <div class="room-msg-body-inner">
                <div class="room-msg-header">
                  <span class="room-msg-author" style="color:<%= mRole ? mRole.color : '#ccc' %>"><%= m.display_name || m.username %></span>
                  <span class="room-msg-time"><%= locals.relTime ? locals.relTime(m.created_at) : new Date(m.created_at).toLocaleString() %></span>
                </div>
                <span class="room-msg-text"><%= m.proto === 'mls' ? '…' : m.body %></span>
                <% if (m.edited_at) { %><span class="edited-indicator" title="<%= new Date(m.edited_at).toLocaleString() %>">(edited)</span><% } %>
              </div>
            </div>
            <div class="room-msg-actions">
            <span class="comment-menu-container room-msg-menu">
              <button class="comment-menu-btn" title="More actions" aria-label="More actions"><%- include('../partials/icon', { name: 'more', size: 14 }) %></button>
              <div class="comment-menu" style="display:none">
                <% if (m.user_id === locals.currentUser.id) { %>
                  <button class="edit-comment-btn room-msg-edit" data-msg-id="<%= m.id %>"><%- include('../partials/icon', { name: 'edit', size: 14 }) %> Edit</button>
                <% } %>
                <% if (m.user_id === locals.currentUser.id || (role && role.permissions & 16) || locals.currentUser.is_admin) { %>
                  <button class="delete-comment-btn room-msg-delete" data-msg-id="<%= m.id %>"><%- include('../partials/icon', { name: 'trash', size: 14 }) %> Delete</button>
                <% } %>
                <button type="button" class="report-item" data-report="room_message" data-report-id="<%= m.id %>" data-report-snapshot=".room-msg-text"><%- include('../partials/icon', { name: 'flag', size: 14 }) %> Report</button>
              </div>
            </span>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (!messages.length) { %><div class="room-msg"><div class="room-msg-body"><div class="room-msg-body-inner"><span class="muted">No messages yet — start the conversation.</span></div></div></div><% } %>
    </div>
    <form class="room-input" id="room-send-form" data-channel-id="<%= firstChannel ? firstChannel.id : '' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="body" placeholder="Message #<%= firstChannel ? firstChannel.name : '' %>" aria-label="Message #<%= firstChannel ? firstChannel.name : '' %>" autocomplete="off">
      <button class="btn" type="submit"><%- include('../partials/icon', { name: 'arrowRight', size: 15 }) %> Send</button>
      <button class="btn ghost" type="button" id="room-attach-btn" style="padding:6px 10px" title="Attach a file (sealed in your browser)" aria-label="Attach a file"><%- include('../partials/icon', { name: 'plus', size: 16 }) %></button>
      <input type="file" id="room-attach-input" hidden>
    </form>
    <div class="attach-chip" id="room-attach-chip" hidden></div>
  </main>
</div>
<div class="report-overlay" id="report-overlay" role="dialog" aria-modal="true" aria-labelledby="report-modal-title" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center">
  <div class="card" style="max-width:400px;width:90%">
    <h3 id="report-modal-title" style="margin-top:0">Report message</h3>
    <div id="report-message-preview" style="padding:10px 12px;background:var(--surface-2);border:1px solid var(--border-soft);border-radius:var(--radius-lg);margin-bottom:14px;font-style:italic"></div>
    <form id="report-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="message_id" id="report-msg-id" value="">
      <label for="report-reason">Reason</label>
      <input type="text" name="reason" id="report-reason" placeholder="What's wrong with this message?" aria-label="Reason for report" required style="width:100%;margin-bottom:14px">
      <div style="display:flex;gap:8px">
        <button class="btn" type="submit"><%- include('../partials/icon', { name: 'flag', size: 15 }) %> Send report</button>
        <button class="btn ghost close-report-overlay" type="button">Cancel</button>
      </div>
    </form>
  </div>
</div>
  <div id="room-members" style="display:none" data-room-id="<%= room.id %>" data-user-id="<%= locals.currentUser.id %>" data-username="<%= locals.currentUser.username %>" data-members='<%= JSON.stringify(members.map(function(m){ return { id: m.user_id, username: m.username }; })) %>'></div>
  <div id="room-e2ee-status" class="muted" style="font-size:0.75rem;text-align:center"></div>
  <script src="/static/rooms.js?v=8"></script>
  <script src="/static/room-e2ee.js?v=2"></script>
  <script src="/static/webrtc-room.js?v=3"></script>
<%- include('../partials/footer') %>