<%- include('partials/header') %>
  <div style="max-width:440px;margin:48px auto">
    <div style="text-align:center;margin-bottom:24px">
      <%- include('partials/rings', { size: 56, animate: true }) %>
      <h2 style="margin:14px 0 4px">Switch account</h2>
      <p class="muted" style="margin:0">Accounts signed in on this device.</p>
    </div>
    <div class="card elevated">
      <% if (error) { %><div class="flash err"><span class="flash-ico"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span><span><%= error %></span></div><% } %>
      <% signedInAccounts.forEach(function(acc) { %>
        <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--border-soft)">
          <% if (acc.avatar) { %><img src="<%= acc.avatar %>" alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;flex:none"><% } else { %><div style="width:38px;height:38px;border-radius:50%;background:var(--primary-soft);color:var(--primary-strong);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex:none"><%= (acc.display_name || acc.username).slice(0,1).toUpperCase() %></div><% } %>
          <span style="flex:1;min-width:0"><strong style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= acc.display_name %></strong><small class="muted">@<%= acc.username %></small></span>
          <% if (String(acc.id) === String(locals.currentUser.id)) { %>
            <span class="btn ghost" style="padding:5px 12px;font-size:var(--fs-xs);cursor:default">Active</span>
          <% } else { %>
            <form method="post" action="/account/switch" style="margin:0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="account_id" value="<%= acc.id %>">
              <input type="hidden" name="next" value="<%= next %>">
              <button class="btn" type="submit" style="padding:5px 12px;font-size:var(--fs-xs)">Use this account</button>
            </form>
          <% } %>
          <form method="post" action="/account/remove" style="margin:0" onsubmit="return confirm('Remove @<%= acc.username %> from this device?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="account_id" value="<%= acc.id %>">
            <input type="hidden" name="next" value="<%= next %>">
            <button class="btn ghost" type="submit" title="Remove from this device" aria-label="Remove @<%= acc.username %> from this device" style="padding:5px 10px;font-size:var(--fs-xs)"><%- include('partials/icon', { name: 'close', size: 14 }) %></button>
          </form>
        </div>
      <% }) %>
      <div style="border-top:1px solid var(--border-soft);padding-top:12px;margin-top:4px;display:flex;gap:14px;align-items:center">
        <a href="/login?add=1&next=<%= encodeURIComponent(next || '/') %>" style="font-size:var(--fs-sm)"><%- include('partials/icon', { name: 'plus', size: 14 }) %> Add another account</a>
        <form method="post" action="/logout" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="all" value="1">
          <button class="btn ghost" type="submit" style="padding:5px 12px;font-size:var(--fs-xs)">Sign out of all accounts</button>
        </form>
      </div>
    </div>
    <p class="muted center" style="margin-top:18px"><a href="<%= next %>">Back</a></p>
  </div>
<%- include('partials/footer') %>
