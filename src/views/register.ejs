<%- include('partials/header') %>
  <div style="max-width:400px;margin:48px auto">
    <div style="text-align:center;margin-bottom:24px">
      <%- include('partials/rings', { size: 56, animate: true }) %>
      <h2 style="margin:14px 0 4px">Join Extrovert</h2>
      <p class="muted" style="margin:0">A network where you only see people your friends know.</p>
    </div>
    <div class="card elevated">
      <% if (error) { %><div class="flash err"><span class="flash-ico"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span><span><%= error %></span></div><% } %>
      <form method="post" action="/register<%= locals.ref ? '?ref=' + encodeURIComponent(ref) : '' %>" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (locals.ref) { %><input type="hidden" name="ref" value="<%= ref %>"><% } %>
        <label for="reg-username">Username</label>
        <input type="text" id="reg-username" name="username" autocomplete="username" autocapitalize="off" autocorrect="off" spellcheck="false" required autofocus placeholder="3–20 chars, no spaces">
        <label for="reg-displayName">Display name <span class="muted">(optional)</span></label>
        <input type="text" id="reg-displayName" name="displayName" placeholder="What should people call you?">
        <label for="reg-password">Password</label>
        <input type="password" id="reg-password" name="password" autocomplete="new-password" required>
        <div id="captcha" class="captcha">
          <div class="captcha-box">
            <span class="captcha-ico"><%- include('partials/icon', { name: 'shield', size: 18 }) %></span>
            <span class="captcha-status" role="status">Type the characters below to prove you're human.</span>
          </div>
          <div class="captcha-row">
            <img id="captcha-img" src="/register/captcha" alt="Captcha image" class="captcha-img" width="160" height="56">
            <input type="text" id="captcha-input" name="captcha" placeholder="Type the characters" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" required aria-label="Characters shown in the captcha image">
            <button type="button" id="captcha-refresh" class="btn ghost captcha-refresh" title="Get new characters" aria-label="Get new characters"><%- include('partials/icon', { name: 'history', size: 18 }) %></button>
          </div>
          <p class="muted captcha-note">Case doesn't matter. Can't read it? Use the refresh button.</p>
        </div>
        <button class="btn full" style="margin-top:20px">Create account</button>
      </form>
    </div>
    <p class="muted center" style="margin-top:18px">Already on Extrovert? <a href="/login">Log in</a></p>
  </div>
<script src="/static/captcha.js?v=3" defer></script>
<%- include('partials/footer') %>