<%- include('partials/header', { wrapClass: 'chat-wrap' }) %>
  <div class="chat-scroll">
  <div class="card chat-header-card" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <div>
      <a href="/chats" class="muted" style="font-size:0.85rem;display:inline-flex;align-items:center;gap:4px"><%- include('partials/icon', { name: 'arrowLeft', size: 13 }) %> Chats</a>
      <h2 style="margin:2px 0 0;font-size:var(--fs-lg)"><%= other.display_name %></h2>
      <small class="muted">@<%= other.username %></small>
      <% if (typeof recipientCurve === 'object' && recipientCurve && recipientCurve.ed25519_key) { %>
        <span class="muted" style="display:inline-flex;align-items:center;gap:4px;font-size:0.75rem">
          safety number: <span id="safety-number" style="font-family:monospace;font-weight:bold;display:none"></span>
        </span>
      <% } %>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="btn ghost" id="dm-security-toggle" type="button"
              data-username="<%= other.username %>"
              data-enabled="<%= security.mine ? '1' : '0' %>"
              data-active="<%= security.active ? '1' : '0' %>"
              title="Additional Security: messages are deleted from the server once both of you have received them">
        <%- include('partials/icon', { name: 'lock', size: 14 }) %>
        <span id="dm-security-label"><% if (security.active) { %>Secure DM: On<% } else if (security.mine) { %>Secure DM: waiting for <%= other.display_name %><% } else { %>Secure DM: Off<% } %></span>
      </button>
      <button class="btn ghost call-btn" data-username="<%= other.username %>" data-display="<%= other.display_name %>"><%- include('partials/icon', { name: 'phone', size: 15 }) %> Call</button>
      <a class="btn ghost" href="/u/<%= other.username %>"><%- include('partials/icon', { name: 'user', size: 15 }) %> Profile</a>
    </div>
  </div>

  <div class="chat-messages">
    <% if (messages.length === 0) { %>
      <div class="center muted" style="padding:2rem">No messages yet — say hello.</div>
    <% } else { %>
      <% messages.forEach(function(m){ %>
        <div class="chat-msg <%= m.from_id === currentUser.id ? 'own' : '' %>"
             data-body="<%= m.body %>"
             data-key-sender="<%= m.key_for_sender || '' %>"
             data-key-recipient="<%= m.key_for_recipient || '' %>"
             data-proto="<%= m.proto || 'rsa' %>"
             data-sender-ciphertext="<%= m.sender_ciphertext || '' %>"
             data-msg-id="<%= m.id %>"
             data-ts="<%= m.created_at %>"
             data-secure="<%= m.secure ? '1' : '0' %>">
           <div class="chat-bubble"><% if (m.body && m.body.startsWith('/uploads/stickers/')) { %><img src="<%= m.body %>" class="sticker-inline" style="max-width:120px;max-height:120px;vertical-align:middle" alt="sticker"><% } else { %><%= m.body %><% } %></div>
           <div class="muted" style="font-size:0.7rem;padding:0 4px">
             <%= locals.relTime(m.created_at) %>
             <% if (m.edited_at) { %><span class="edited-indicator" title="<%= new Date(m.edited_at).toLocaleString() %>">· edited</span><% } %>
             <% if (m.from_id === currentUser.id) { %>
               <button class="edit-msg-btn" style="font-size:0.7rem;color:var(--text-muted);background:none;border:none;cursor:pointer;padding:0 2px;margin-left:4px;text-decoration:underline">Edit</button>
               <button class="delete-msg-btn" data-msg-id="<%= m.id %>" data-csrf="<%= csrfToken %>" data-action="/chats/<%= other.username %>/delete/<%= m.id %>" style="font-size:0.7rem;color:var(--text-muted);background:none;border:none;cursor:pointer;padding:0 2px;margin-left:4px;text-decoration:underline">Delete</button>
             <% } %>
           </div>
           <% if (m.from_id === currentUser.id) { %>
             <input type="hidden" class="edit-msg-data" value="<%= m.body %>" data-csrf="<%= csrfToken %>" data-action="/chats/<%= other.username %>/edit/<%= m.id %>">
           <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
  </div>

  <form class="chat-form" method="post" action="/chats/<%= other.username %>/send"
        data-pubkey="<%= recipientPubKey || '' %>"
        data-recipient="<%= other.id %>"
        data-recipient-username="<%= other.username %>"
        data-recipient-curve="<%= (typeof recipientCurve === 'object' && recipientCurve ? recipientCurve.identity_key : '') %>"
        data-recipient-ready="<%= (typeof recipientCurve === 'object' && recipientCurve ? '1' : '0') %>"
        data-current-user="<%= currentUser.id %>"
        data-security-active="<%= security.active ? '1' : '0' %>"
        style="position:relative">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="body" id="sticker-input-chat" placeholder="Type a message…" maxlength="2000" required autofocus aria-label="Type a message"<%= (typeof recipientCurve === 'object' && recipientCurve) ? '' : ' disabled' %>>
    <button<%= (typeof recipientCurve === 'object' && recipientCurve) ? '' : ' disabled' %>><%- include('partials/icon', { name: 'arrowRight', size: 16 }) %> Send</button>
    <button class="btn ghost sticker-btn" data-target="sticker-popup-chat" type="button" style="padding:6px 10px" title="Stickers" aria-label="Open stickers"<%= (typeof recipientCurve === 'object' && recipientCurve) ? '' : ' disabled' %>><%- include('partials/icon', { name: 'smile', size: 18 }) %></button>
    <div id="sticker-popup-chat" style="display:none;position:absolute;bottom:100%;right:0;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);z-index:100;box-shadow:var(--shadow)"></div>
  </form>
  <div id="chat-send-error" class="muted" style="display:none;text-align:center;font-size:0.85rem;color:var(--danger);padding:6px 0"></div>
  <div class="muted" style="font-size:0.75rem;text-align:center;padding:6px 0">
    Encryption problems? <a href="#" class="e2ee-reset-link" style="color:var(--text-muted);text-decoration:underline">Reset encryption keys</a>
  </div>
  <div id="e2ee-identity-mismatch" class="card" style="display:none;text-align:center;padding:0.9rem 1rem;margin-top:10px">
    <p class="muted" style="margin:0;font-size:0.85rem">
      Your local encryption keys no longer match the ones on the server, so incoming messages can't be decrypted.
      <a href="#" class="e2ee-reset-link" style="color:var(--text-muted);text-decoration:underline">Reset encryption keys</a> to start fresh — your contacts reconnect automatically on their next message.
    </p>
  </div>
  <div id="dm-security-notice" class="card" style="display:<%= security.active ? 'block' : 'none' %>;text-align:center;padding:0.9rem 1rem;margin-top:10px">
    <p class="muted" style="margin:0;font-size:0.85rem"><%- include('partials/icon', { name: 'lock', size: 13 }) %> <strong>Additional Security is on.</strong> Messages are removed from the server as soon as both of you have received them — they live only on your devices.</p>
  </div>

  <div id="e2ee-recipient-notice" class="card" style="display:<%= (typeof recipientCurve === 'object' && recipientCurve) ? 'none' : 'block' %>;text-align:center;padding:2rem">
    <p><%- include('partials/icon', { name: 'lock', size: 24 }) %></p>
    <p><strong><%= other.display_name %></strong> hasn't set up end-to-end encryption yet. Ask them to log in to the site once to generate their encryption keys, then try again.</p>
  </div>

  <div id="e2ee-unlock-overlay" role="dialog" aria-modal="true" aria-labelledby="e2ee-unlock-title" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;align-items:center;justify-content:center" data-username="<%= other.username %>">
    <div class="card" style="max-width:360px;width:90%;text-align:center">
      <h3 id="e2ee-unlock-title">Unlock End-to-End Encryption</h3>
      <p class="muted">Enter your password to decrypt your keys and enable secure messaging.</p>
      <input type="password" id="e2ee-password" placeholder="Password" aria-label="Password" autocomplete="current-password" style="width:100%;margin-bottom:10px">
      <button class="btn" id="e2ee-unlock-btn">Unlock</button>
      <div id="e2ee-unlock-error" style="color:var(--danger);margin-top:8px;display:none"></div>
      <a href="#" id="e2ee-reset-link" class="e2ee-reset-link" style="display:block;margin-top:12px;font-size:0.8rem;color:var(--text-muted)">Forgot password or can't unlock? Reset keys</a>
    </div>
  </div>
<%- include('partials/footer') %>
