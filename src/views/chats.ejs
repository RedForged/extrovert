<%- include('partials/header', { wrapClass: 'wrap-wide' }) %>
  <div class="card" style="display:flex;justify-content:space-between;align-items:center">
    <h2 style="margin:0">Chats</h2>
  </div>

  <% if (conversations.length === 0) { %>
    <div class="card empty-state">
      <div class="empty-art"><%- include('partials/rings', { size: 56, animate: true }) %></div>
      <h4>No chats yet</h4>
      <p>When you and a friend follow each other, you can send messages here.</p>
      <a class="btn" href="/discover"><%- include('partials/icon', { name: 'search', size: 15 }) %> Find people to talk to</a>
    </div>
  <% } else { %>
    <% conversations.forEach(function(c){ %>
      <a href="/chats/<%= c.username %>" class="card conv-row" style="text-decoration:none">
        <% if (c.avatar) { %><img src="<%= c.avatar %>" alt="" class="avatar-img"><% } else { %><div class="avatar"><%= (c.display_name || '?').slice(0,1).toUpperCase() %></div><% } %>
        <div class="info">
          <b><%= c.display_name %></b> <span class="online-dot" data-user="<%= c.username %>"></span>
          <% if (c.security_active) { %><span class="muted" title="Additional Security enabled — messages deleted from the server after delivery" style="font-size:0.8rem"><%- include('partials/icon', { name: 'lock', size: 11 }) %></span><% } %>
          <small>@<%= c.username %></small>
        <% var lm = c.last_message || ''; %>
        <div class="muted chat-preview" style="font-size:0.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
             data-proto="<%= c.last_proto || '' %>" data-body="<%= lm %>"
             data-key-sender="<%= c.last_key_for_sender || '' %>" data-key-recipient="<%= c.last_key_for_recipient || '' %>"
             data-sender-ciphertext="<%= c.last_sender_ciphertext || '' %>"
             data-own="<%= c.last_from === currentUser.id ? '1' : '0' %>"
             data-other-id="<%= c.id %>" data-curve="<%= c.sender_curve || '' %>"><%= lm ? (lm.startsWith('/uploads/stickers/') ? 'Sticker' : '…') : 'Start a conversation' %></div>
        </div>
        <% if (c.unread > 0) { %><sup class="badge"><%= c.unread %></sup><% } %>
      </a>
    <% }) %>
  <% } %>
<%- include('partials/footer') %>