<nav class="nav">
  <%
    const _cp = locals.currentPath || '';
    const isActive = (p) => _cp === p || (_cp && p !== '/' && _cp.indexOf(p) === 0);
  %>
  <a class="brand" href="/" aria-label="Extrovert home">
    <span class="brand-rings"><%- include('rings', { size: 22 }) %></span>
    Extrovert
  </a>
  <% if (locals.currentUser) { %>
    <a href="/" title="Feed" class="<%= _cp === '/' ? 'active' : '' %>"><span class="nav-icon"><%- include('icon', { name: 'home', size: 18 }) %></span><span class="nav-text">Feed</span></a>
    <a href="/chats" title="Chats" class="<%= isActive('/chats') ? 'active' : '' %>"><span class="nav-icon"><%- include('icon', { name: 'chat', size: 18 }) %></span><span class="nav-text">Chats</span><% if (locals.unreadMessages > 0) { %><sup class="badge"><%= unreadMessages %></sup><% } %></a>
    <a href="/inbox" title="Notifications" class="<%= isActive('/inbox') ? 'active' : '' %>"><span class="nav-icon"><%- include('icon', { name: 'bell', size: 18 }) %></span><span class="nav-text">Notifications</span><% if (locals.unreadCount > 0) { %><sup class="badge"><%= unreadCount %></sup><% } %></a>
    <a href="/u/<%= currentUser.username %>" title="Profile" class="<%= _cp === '/u/' + currentUser.username ? 'active' : '' %> nav-overflow"><span class="nav-icon"><%- include('icon', { name: 'user', size: 18 }) %></span><span class="nav-text">Profile</span></a>
    <a href="/rooms" title="Rooms" class="<%= isActive('/rooms') ? 'active' : '' %> nav-overflow"><span class="nav-icon"><%- include('icon', { name: 'rooms', size: 18 }) %></span><span class="nav-text">Rooms</span></a>
    <a href="/settings" title="Settings" class="<%= isActive('/settings') ? 'active' : '' %> nav-overflow"><span class="nav-icon"><%- include('icon', { name: 'settings', size: 18 }) %></span><span class="nav-text">Settings</span></a>
    <% if (locals.currentUser && locals.currentUser.is_admin) { %><a href="/admin" title="Admin" class="<%= isActive('/admin') ? 'active' : '' %> nav-overflow"><span class="nav-icon"><%- include('icon', { name: 'shield', size: 18 }) %></span><span class="nav-text">Admin</span><% if (locals.pendingReports > 0 || (locals.securityReports || 0) > 0) { %><sup class="badge"><%= (locals.pendingReports || 0) + (locals.securityReports || 0) %></sup><% } %></a><% } %>
    <% if (locals.currentUser) { %><a href="/security" title="Security &amp; responsible disclosure" class="<%= isActive('/security') ? 'active' : '' %> nav-overflow"><span class="nav-icon"><%- include('icon', { name: 'lock', size: 18 }) %></span><span class="nav-text">Security</span></a><% } %>
    <details class="menu-dd nav-more" open>
      <summary title="More"><%- include('icon', { name: 'more', size: 18 }) %></summary>
      <div class="menu-dd-pop">
        <a href="/u/<%= currentUser.username %>"><%- include('icon', { name: 'user', size: 15 }) %> Profile</a>
        <a href="/rooms"><%- include('icon', { name: 'rooms', size: 15 }) %> Rooms</a>
        <a href="/settings"><%- include('icon', { name: 'settings', size: 15 }) %> Settings</a>
        <% if (locals.currentUser && locals.currentUser.is_admin) { %><a href="/admin"><%- include('icon', { name: 'shield', size: 15 }) %> Admin<% if (locals.pendingReports > 0 || (locals.securityReports || 0) > 0) { %> <sup class="badge"><%= (locals.pendingReports || 0) + (locals.securityReports || 0) %></sup><% } %></a><% } %>
        <a href="/security"><%- include('icon', { name: 'lock', size: 15 }) %> Security</a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button><%- include('icon', { name: 'logout', size: 15 }) %> Log out</button></form>
      </div>
    </details>
    <% if (locals.announcement) { %>
      <div class="ann" id="ann">
        <% if (locals.currentUser && locals.currentUser.is_admin) { %>
          <a class="ann-pill ann-pill-admin" href="/admin/announcement" title="Edit announcement">
            <span class="ann-pill-glow" aria-hidden="true"></span>
            <%- include('icon', { name: 'megaphone', size: 16 }) %>
            <span class="ann-pill-text"><%= announcement.body %></span>
            <span class="ann-pill-edit" title="Edit"><%- include('icon', { name: 'edit', size: 12 }) %></span>
          </a>
        <% } else { %>
          <button type="button" class="ann-pill" id="ann-pill" aria-expanded="false" aria-haspopup="dialog" title="View announcement">
            <span class="ann-pill-glow" aria-hidden="true"></span>
            <%- include('icon', { name: 'megaphone', size: 16 }) %>
            <span class="ann-pill-text"><%= announcement.body %></span>
          </button>
          <div class="ann-popover" id="ann-popover" role="dialog" aria-labelledby="ann-popover-title" hidden>
            <div class="ann-popover-arrow" aria-hidden="true"></div>
            <div class="ann-popover-header">
              <span class="ann-popover-icon"><%- include('icon', { name: 'megaphone', size: 18 }) %></span>
              <span class="ann-popover-title" id="ann-popover-title">Announcement</span>
              <button type="button" class="ann-close" aria-label="Dismiss"><%- include('icon', { name: 'close', size: 14 }) %></button>
            </div>
            <div class="ann-popover-body"><%= announcement.body %></div>
            <div class="ann-popover-meta">
              <% if (announcement.author_display_name || announcement.author_username) { %>
                <span class="ann-author">by <span class="ann-author-name"><%= announcement.author_display_name || announcement.author_username %></span></span>
              <% } %>
              <% if (announcement.updated_at) { %><span class="ann-updated"><%= locals.relTime(announcement.updated_at) %></span><% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
    <span class="spacer"></span>
    <span class="account-switcher">
      <button type="button" class="account-switcher-summary" id="account-chip" aria-haspopup="dialog" aria-expanded="false" aria-controls="account-sheet" title="Account">
        <span class="account-switcher-avatar">
          <% if (locals.currentUser.avatar) { %><img src="<%= locals.currentUser.avatar %>" alt=""><% } else { %><span class="account-switcher-avatar-letter"><%= (locals.currentUser.display_name || locals.currentUser.username).slice(0,1).toUpperCase() %></span><% } %>
        </span>
        <span class="nav-text"><%= locals.currentUser.display_name %></span>
        <%- include('icon', { name: 'more', size: 14 }) %>
      </button>
    </span>
    <form method="post" action="/logout" class="nav-overflow" style="margin:0"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button title="Log out of this account"><span class="nav-icon"><%- include('icon', { name: 'logout', size: 18 }) %></span><span class="nav-text">Log out</span></button></form>
  <% } else { %>
    <span class="spacer"></span>
    <a href="/login">Log in</a>
    <a class="btn" href="/register" style="min-height:34px">Sign up</a>
  <% } %>
</nav>