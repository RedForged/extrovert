<%
  const u = locals.currentUser;
  const time = locals.relTime || ((t) => new Date(t).toLocaleString());
%>
<article class="post">
  <% if (item.isRepost) { %>
    <div class="post-repost"><%- include('icon', { name: 'repost', size: 14 }) %> <%= item.reposterName %> reposted</div>
  <% } %>
  <header class="post-head">
    <% if (item.authorAvatar) { %><a class="post-avatar-link" href="/u/<%= item.authorUsername %>"><img src="<%= item.authorAvatar %>" alt="" class="post-avatar-img"></a><% } else { %><a class="post-avatar" href="/u/<%= item.authorUsername %>"><%= (item.authorName || '?').slice(0,1).toUpperCase() %></a><% } %>
    <div>
      <div style="display:flex;align-items:center;gap:6px">
        <a href="/u/<%= item.authorUsername %>" class="post-name"><%= item.authorName %></a>
        <% if (u && !item.isOwn) { %>
          <% if (item.mutual) { %>
            <a href="/chats/<%= item.authorUsername %>" class="chat-icon" title="Send a message"><%- include('icon', { name: 'chat', size: 15 }) %></a>
          <% } else { %>
            <span class="chat-icon locked" title="Follow each other to start chatting"><%- include('icon', { name: 'lock', size: 13 }) %></span>
          <% } %>
        <% } %>
      </div>
      <span class="post-handle">@<%= item.authorUsername %></span>
      <span class="post-time">· <%= time(item.createdAt) %></span>
      <% if (item.editedAt) { %><span class="post-time edited-badge" title="<%= new Date(item.editedAt).toLocaleString() %>">· edited</span><% } %>
    </div>
  </header>

  <% if (item.body) { %><div class="post-body"><%= item.body %></div><% } %>
  <% if (item.editedAt) { %><div class="post-edited"><a href="/posts/<%= item.interactId %>/history?type=post" class="edited-link" title="<%= new Date(item.editedAt).toLocaleString() %>">(edited)</a></div><% } %>
  <% if (item.mediaPath && item.type === 'photo') { %>
    <img class="post-media" src="<%= item.mediaPath %>" alt="photo">
  <% } else if (item.mediaPath && item.type === 'video') { %>
    <video class="post-media" controls src="<%= item.mediaPath %>"></video>
  <% } %>

  <div class="post-stats">
    <span class="stat" data-stat="like"><span class="ico"><%- include('icon', { name: item.liked ? 'heartFilled' : 'heart', size: 14 }) %></span> <%= item.likeCount %></span>
    <span class="stat" data-stat="comment"><span class="ico"><%- include('icon', { name: 'comment', size: 14 }) %></span> <%= item.commentCount %></span>
    <span class="stat" data-stat="share"><span class="ico"><%- include('icon', { name: 'share', size: 14 }) %></span> <%= item.shareCount %></span>
    <% if (item.followBoost > 0) { %><span class="boost"><%- include('icon', { name: 'starFilled', size: 13 }) %> followed from post ×<%= item.followBoost %></span><% } %>
  </div>

  <% if (u) { %>
  <% const _token = typeof csrfToken !== 'undefined' ? csrfToken : (locals.csrfToken || ''); %>
  <div class="post-actions">
    <form method="post" action="/posts/<%= item.interactId %>/like">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button class="<%= item.liked ? 'active' : '' %>"><%- include('icon', { name: item.liked ? 'heartFilled' : 'heart', size: 15, cls: 'ico' }) %> <%= item.liked ? 'Liked' : 'Like' %></button>
    </form>
    <form method="post" action="/posts/<%= item.interactId %>/share">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button class="<%= item.shared ? 'active' : '' %>"><%- include('icon', { name: 'share', size: 15, cls: 'ico' }) %> <%= item.shared ? 'Shared' : 'Share' %></button>
    </form>
    <form method="post" action="/posts/<%= item.interactId %>/repost">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <button><%- include('icon', { name: 'repost', size: 15, cls: 'ico' }) %> Repost</button>
    </form>
    <% if (!item.isOwn && !item.followingAuthor) { %>
      <form method="post" action="/posts/<%= item.interactId %>/follow-from">
        <input type="hidden" name="_csrf" value="<%= _token %>">
        <button class="boost-btn"><%- include('icon', { name: 'star', size: 15, cls: 'ico' }) %> Follow from post</button>
      </form>
    <% } %>
    <% if (item.isOwn) { %>
      <button class="btn ghost edit-post-btn" data-post-id="<%= item.id %>" style="margin-left:auto"><%- include('icon', { name: 'edit', size: 15 }) %> Edit</button>
      <a class="btn ghost danger" href="/posts/<%= item.interactId %>/delete"><%- include('icon', { name: 'trash', size: 15 }) %> Delete</a>
    <% } %>
  </div>
  <% if (item.isOwn) { %>
    <input type="hidden" class="edit-post-data" value="<%= item.body %>" data-csrf="<%= _token %>" data-action="/posts/<%= item.interactId %>/edit">
  <% } %>

  <div class="post-comments">
    <% (item.comments || []).forEach(function(c){ %>
      <div class="comment" data-comment-id="<%= c.id %>">
        <div class="comment-head">
          <div>
            <b><%= c.display_name %></b> <span class="post-handle">@<%= c.username %></span>
            <span class="post-time">· <%= time(c.created_at) %></span>
            <% if (c.edited_at) { %><a href="/posts/<%= c.id %>/history?type=comment&post_id=<%= item.interactId %>" class="edited-link" title="<%= new Date(c.edited_at).toLocaleString() %>">(edited)</a><% } %>
          </div>
          <% if (u && c.user_id === u.id) { %>
            <div class="comment-menu-container">
              <button class="comment-menu-btn" title="More"><%- include('icon', { name: 'more', size: 16 }) %></button>
              <div class="comment-menu" style="display:none">
                <button class="edit-comment-btn"><%- include('icon', { name: 'edit', size: 14 }) %> Edit</button>
                <form method="post" action="/posts/<%= item.interactId %>/comments/<%= c.id %>/delete" class="delete-comment-form">
                  <input type="hidden" name="_csrf" value="<%= _token %>">
                  <button class="delete-comment-btn"><%- include('icon', { name: 'trash', size: 14 }) %> Delete</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
        <span class="comment-body"><% if (c.body && c.body.startsWith('/uploads/stickers/')) { %><img src="<%= c.body %>" class="sticker-inline" style="max-width:120px;max-height:120px;vertical-align:middle" alt="sticker"><% } else { %><%= c.body %><% } %></span>
        <% if (u && c.user_id === u.id) { %>
          <input type="hidden" class="edit-comment-data" value="<%= c.body %>" data-csrf="<%= _token %>" data-action="/posts/<%= item.interactId %>/comments/<%= c.id %>/edit">
        <% } %>
      </div>
    <% }) %>
    <form class="comment-form" method="post" action="/posts/<%= item.interactId %>/comment" style="position:relative">
      <input type="hidden" name="_csrf" value="<%= _token %>">
      <input type="text" name="body" id="sticker-input-<%= item.interactId %>" placeholder="Add a comment…" maxlength="1000" required>
      <button><%- include('icon', { name: 'comment', size: 15 }) %> Comment</button>
      <button class="btn ghost sticker-btn" data-target="sticker-popup-<%= item.interactId %>" type="button" style="font-size:18px;padding:6px 10px" title="Stickers"><%- include('icon', { name: 'smile', size: 18 }) %></button>
      <div id="sticker-popup-<%= item.interactId %>" style="display:none;position:absolute;bottom:100%;right:0;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);z-index:100;box-shadow:var(--shadow)"></div>
    </form>
  </div>
  <% } %>
</article>