<!doctype html>
<html lang="en" data-theme="<%= locals.theme || 'dark' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.pageTitle ? pageTitle + ' · Extrovert' : 'Extrovert' %></title>
  <link rel="stylesheet" href="/static/theme.css?v=3">
  <link rel="manifest" href="/static/manifest.webmanifest">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.id) { %><meta name="current-user-id" content="<%= currentUser.id %>"><% } %>
  <script src="/static/lib/olm.js?v=1"></script>
  <script src="/static/e2ee.js?v=25"></script>
  <script src="/static/copy-ref.js?v=2"></script>
  <script src="/static/stickers.js?v=1"></script>
  <script src="/static/icons.js?v=1"></script>
  <script src="/static/interact.js?v=5"></script>
  <script src="/static/webrtc.js?v=3"></script>
  <script src="/static/webrtc-ui.js?v=2"></script>
  <script src="/static/announcement.js?v=1"></script>
  <script src="/static/push-register.js?v=1"></script>
</head>
<body>
  <%- include('nav') %>
  <% if (locals.verifyBanner) { %>
    <div class="verify-banner" role="status">
      <%- include('icon', { name: 'alert', size: 16 }) %>
      <span>Verify your email address to unlock full access. <a href="/settings">Add or verify your email</a>.</span>
    </div>
  <% } %>
  <main class="wrap<%= locals.wrapClass ? ' ' + locals.wrapClass : '' %>">
