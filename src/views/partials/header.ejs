<!doctype html>
<html lang="en" data-theme="<%= locals.theme || 'dark' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.pageTitle ? pageTitle + ' · Extrovert' : 'Extrovert' %></title>
  <link rel="stylesheet" href="/static/theme.css?v=28">
  <% if (locals.headCss) { %><style<% if (locals.headCssId) { %> id="<%= locals.headCssId %>"<% } %>><%- headCss %></style><% } %>
  <% if (locals.headFontCss) { %><style id="ev-font-face"><%- headFontCss %></style><% } %>
  <% if (locals.headExtraCss) { %><style id="ev-post-scope"><%- headExtraCss %></style><% } %>
  <link rel="manifest" href="/static/manifest.webmanifest">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.id) { %><meta name="current-user-id" content="<%= currentUser.id %>"><meta name="current-username" content="<%= currentUser.username %>"><% } %>
  <script src="/static/lib/mls.js?v=1"></script>
  <script src="/static/mls-client.js?v=9"></script>
  <script src="/static/file-crypto.js?v=2"></script>
  <script src="/static/e2ee.js?v=37"></script>
  <script src="/static/report.js?v=1"></script>
  <script src="/static/copy-ref.js?v=3"></script>
  <script src="/static/stickers.js?v=1"></script>
  <script src="/static/icons.js?v=2"></script>
  <script src="/static/interact.js?v=8"></script>
  <script src="/static/webrtc.js?v=7"></script>
  <script src="/static/webrtc-ui.js?v=4"></script>
  <script src="/static/announcement.js?v=1"></script>
  <script src="/static/push-register.js?v=1"></script>
</head>
<body>
  <%- include('nav') %>
  <% if (locals.currentUser) { %>
  <div class="sheet-backdrop" id="account-sheet-backdrop" hidden></div>
  <div class="sheet" id="account-sheet" role="dialog" aria-modal="true" aria-label="Account" hidden>
    <div class="sheet-handle" aria-hidden="true"></div>
    <% if ((locals.signedInAccounts || []).length > 1) { %>
      <p class="sheet-title">Switch account</p>
      <% (locals.signedInAccounts || []).forEach(function(acc) { %>
        <form method="post" action="/account/switch" class="account-switcher-row">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <input type="hidden" name="account_id" value="<%= acc.id %>">
          <input type="hidden" name="next" value="<%= locals.currentPath || '/' %>">
          <button type="submit" class="account-switcher-btn <%= String(acc.id) === String(locals.currentUser.id) ? 'active' : '' %>" title="Use @<%= acc.username %>">
            <span class="account-switcher-row-avatar">
              <% if (acc.avatar) { %><img src="<%= acc.avatar %>" alt=""><% } else { %><span class="account-switcher-avatar-letter"><%= (acc.display_name || acc.username).slice(0,1).toUpperCase() %></span><% } %>
            </span>
            <span class="account-switcher-row-name">
              <strong><%= acc.display_name %></strong>
              <small>@<%= acc.username %></small>
            </span>
            <% if (String(acc.id) === String(locals.currentUser.id)) { %><span class="account-switcher-check"><%- include('icon', { name: 'check', size: 14 }) %></span><% } %>
          </button>
        </form>
      <% }) %>
      <a class="account-switcher-link" href="/login?add=1&next=<%= encodeURIComponent(locals.currentPath || '/') %>"><%- include('icon', { name: 'plus', size: 14 }) %> Add another account</a>
      <div class="sheet-divider"></div>
    <% } %>
    <a class="sheet-row" href="/u/<%= locals.currentUser.username %>?edit=1"><%- include('icon', { name: 'edit', size: 18 }) %> Edit profile</a>
    <% if (locals.inviteUrl) { %>
      <button type="button" class="sheet-row copy-ref" data-link="<%= locals.inviteUrl %>"><%- include('icon', { name: 'link', size: 18 }) %> <span class="copy-ref-label">Copy invite link</span></button>
    <% } else { %>
      <form method="post" action="/u/<%= locals.currentUser.username %>/referral" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <input type="hidden" name="next" value="<%= locals.currentPath || '/' %>">
        <button type="submit" class="sheet-row"><%- include('icon', { name: 'link', size: 18 }) %> Create invite link</button>
      </form>
    <% } %>
    <a class="sheet-row" href="/settings"><%- include('icon', { name: 'settings', size: 18 }) %> Settings</a>
    <form method="post" action="/logout" style="margin:0">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <button type="submit" class="sheet-row sheet-row-danger"><%- include('icon', { name: 'logout', size: 18 }) %> Sign out</button>
    </form>
  </div>
  <% } %>
  <% if (locals.verifyBanner) { %>
    <div class="verify-banner" role="status">
      <%- include('icon', { name: 'alert', size: 16 }) %>
      <span>Verify your email address to unlock full access. <a href="/settings">Add or verify your email</a>.</span>
    </div>
  <% } %>
  <main class="wrap<%= locals.wrapClass ? ' ' + locals.wrapClass : '' %>">
