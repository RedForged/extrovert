SESSION_SECRET=generate-a-random-64-char-string

# HTTP port (default 3000) and bind interface (default 0.0.0.0).
# Set HOST=127.0.0.1 when a reverse proxy on this host terminates TLS, so the
# app port cannot be reached directly.
# PORT=3000
# HOST=0.0.0.0

# Two-factor authentication (TOTP). Required to ENABLE 2FA on an instance —
# TOTP secrets are encrypted at rest with this key (AES-256-GCM). Generate:
#   openssl rand -base64 32
# Without it, the Security settings page explains that 2FA is unavailable.
# TOTP_ENCRYPTION_KEY=

# Rate-limit overrides (requests per window). Defaults: login/register 30/min,
# second-factor endpoints 10/5min, OAuth factor step 10/5min,
# general actions 240/min per-user, E2EE crypto endpoints 600/min per-user.
# NOTE: E2EE crypto POSTs (/chats/, /rooms/, /mls/) are exempt from the general
# action limiter and get their own generous budget — throttling them is what
# breaks message delivery (self-inflicted DoS).
# EXTV_AUTH_RATE_LIMIT=30
# EXTV_SECOND_FACTOR_RATE_LIMIT=10
# EXTV_OAUTH_FACTOR_RATE_LIMIT=10
# EXTV_ACTION_RATE_LIMIT=240
# EXTV_CRYPTO_RATE_LIMIT=600

# Bots (Discord-style API accounts). Each user may own this many; each bot
# token gets its own request budget.
# EXTV_BOT_LIMIT_PER_USER=10
# EXTV_BOT_RATE_LIMIT=120

# Storage each user may use, in bytes, for everything they upload (chat
# attachments, post media, avatars, stickers, API media). Admins can change the
# live value at /admin/storage; this is the fallback when they haven't.
# Default: 52428800 (50 MB).
# EXTV_DRIVE_QUOTA_BYTES=52428800

# Path to ots-sanitize, the OpenType Sanitizer used to validate and re-serialize
# uploaded profile fonts. Ships in the Docker image; installed via the
# opentype-sanitizer package. When it is missing, fonts are stored un-sanitized
# and a warning is logged once.
# EXTV_OTS_SANITIZE=/usr/bin/ots-sanitize

# ICE servers for WebRTC calls and voice channels, as a JSON array (STUN/TURN).
# EXTV_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]
# Shorthand for a single STUN server.
# EXTV_STUN_SERVER=stun:stun.example.org:3478

# OpenID Connect issuer URL (defaults to https://extrovert.redforged.eu)
# OIDC_ISSUER=https://extrovert.redforged.eu

# OIDC private key (PEM string). If set, overrides the key file on disk.
# OIDC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# OIDC_KID=my-key-id

# Trust proxy setting (default: false). Set to 'loopback,10.0.0.0/8' or similar
# when running behind a reverse proxy (nginx, Caddy, HAProxy) that strips
# client-sent X-Forwarded-For headers.
# TRUST_PROXY=loopback,10.0.0.0/8

# Security contact shown on /.well-known/security.txt and the /security page.
# Optional: when unset, no email is advertised (the in-app form and the
# /security URL serve as the contact instead).
# SECURITY_CONTACT_EMAIL=security@example.org

# Optional: override database paths for testing
# EXTV_DB_PATH=/custom/path/extrovert.db
# EXTV_SESSION_DB_PATH=/custom/path/sessions.db

# Cookie security: set to 'false' for local HTTP dev
# EXTV_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Email verification + built-in mail server (all optional; configurable live
# from /admin/mail — these env vars act as fallback defaults for anything you
# don't set in the admin UI).
#
# Policy: off (default) | optional | required
#   required = unverified accounts are read-only until they verify an email
# EXTV_EMAIL_POLICY=optional
#
# Delivery mode: auto (default; deliver to recipient's MX or the relay below)
#                capture (write .eml to data/outbox, never touch the network)
# EXTV_MAIL_MODE=auto
#
# Sender address + display name. Defaults to noreply@<your-domain>, derived
# automatically from the instance's public URL (no IP required). Override only
# if you want a different From address. See docs/mail.md for the
# SPF/DKIM/DMARC/DNS setup that keeps mail out of spam.
# EXTV_MAIL_FROM=noreply@example.com
# EXTV_MAIL_FROM_NAME=Extrovert
# EXTV_MAIL_BOUNCE_FROM=postmaster@example.com
#
# Optional SMTP relay (host:port) — otherwise delivery is direct to MX.
# EXTV_MAIL_RELAY=smtp.example.com:587
#
# STARTTLS: opportunistic (default) | required | off
# EXTV_MAIL_STARTTLS=opportunistic
#
# DKIM: signing domain + selector. Key auto-generates on first send unless
# EXTV_MAIL_DKIM_PRIVATE_KEY (PEM) is provided. Signing is on by default.
# EXTV_MAIL_DKIM=1
# EXTV_MAIL_DKIM_DOMAIN=example.com
# EXTV_MAIL_DKIM_SELECTOR=extrovert
# EXTV_MAIL_DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
#
# Reliability / fallback (defaults shown).
# EXTV_MAIL_TIMEOUT_MS=15000
# EXTV_MAIL_MAX_ATTEMPTS=3
# EXTV_MAIL_RETRY_BASE_MS=30000
# EXTV_MAIL_OUTBOX_FALLBACK=true
# EXTV_MAIL_LOG=info

